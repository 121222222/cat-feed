/* 可接单列表页样式 */
.filter-bar {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 30rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid #F5EDE5;
  position: relative;
  z-index: 101;
  flex-wrap: wrap;
}

.filter-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 50rpx;
  background: #F5F5F5;
  font-size: 24rpx;
  color: #666;
  transition: all 0.2s ease;
}

.filter-item:active {
  opacity: 0.8;
}

.filter-active {
  background: #FFEFE9;
  color: #FFBAA3;
  border: 1rpx solid #FFBAA3;
}

.filter-active .filter-arrow {
  color: #FFBAA3;
  transform: rotate(180deg);
}

.filter-arrow {
  font-size: 18rpx;
  color: #999;
  transition: transform 0.2s ease;
}

/* 筛选下拉面板 */
.filter-dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 99;
}

.filter-dropdown {
  position: relative;
  z-index: 100;
  background: #FFFFFF;
  margin: 0 30rpx;
  border-radius: 0 0 20rpx 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
  padding: 12rpx 0;
  max-height: 500rpx;
  overflow-y: auto;
}

.dropdown-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  font-size: 28rpx;
  color: #333;
}

.dropdown-option:active {
  background: #FFF7F4;
}

.option-active {
  color: #FFBAA3;
  font-weight: 600;
  background: #FFF7F4;
}

.option-check {
  font-size: 28rpx;
  color: #FFBAA3;
  font-weight: 700;
}

.list-container {
  padding: 20rpx 30rpx;
}

.need-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 186, 163, 0.08);
}

.need-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.need-user-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.need-user-name {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.need-user-dorm {
  display: block;
  font-size: 20rpx;
  color: #999;
}

.need-reward {
  font-size: 28rpx;
  font-weight: 700;
  color: #FFBAA3;
}

.need-content {
  margin-bottom: 12rpx;
}

.need-cat-row {
  display: flex;
  gap: 16rpx;
}

.cat-mini-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #FFEFE9;
  flex-shrink: 0;
}

.cat-mini-avatar image {
  width: 100%;
  height: 100%;
}

.need-cat-detail {
  flex: 1;
}

.cat-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 6rpx;
}

.cat-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.need-meta-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 12rpx;
}

.meta-item {
  font-size: 22rpx;
  color: #999;
}

.need-service-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.service-tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  background: #FFEFE9;
  color: #FFBAA3;
  font-size: 20rpx;
  border-radius: 6rpx;
}

.need-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EDE5;
}

.need-time {
  font-size: 22rpx;
  color: #CCC;
}
