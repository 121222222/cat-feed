.page-container {
  padding: 20rpx;
  background: #FFF7F4;
  min-height: 100vh;
}

.draft-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.draft-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 186, 163, 0.08);
}

.draft-cover {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #FFEFE9;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
}

.draft-cover image {
  width: 100%;
  height: 100%;
}

.draft-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.media-type-tag {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 8rpx;
  padding: 4rpx 8rpx;
  font-size: 20rpx;
}

.draft-info {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.draft-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.draft-content {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  font-size: 24rpx;
  color: #666;
}

.draft-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.draft-time {
  font-size: 22rpx;
  color: #999;
}

.draft-media-count {
  font-size: 22rpx;
  color: #FFBAA3;
  background: #FFF2ED;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.draft-delete {
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: #FFF2F0;
  font-size: 24rpx;
  color: #FF4D4F;
  flex-shrink: 0;
}

.draft-delete:active {
  opacity: 0.7;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-tip {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 16rpx 50rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}

.empty-btn:active {
  opacity: 0.8;
}
