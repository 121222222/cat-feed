<view class="page-container">
  <view class="draft-list" wx:if="{{drafts.length > 0}}">
    <view class="draft-item" wx:for="{{drafts}}" wx:key="index" bindtap="editDraft" data-index="{{index}}">
      <!-- 封面 -->
      <view class="draft-cover">
        <image wx:if="{{item.mediaType === 'image' && item.photos.length > 0}}" src="{{item.photos[0]}}" mode="aspectFill"></image>
        <image wx:elif="{{item.mediaType === 'video' && item.video.thumbTempFilePath}}" src="{{item.video.thumbTempFilePath}}" mode="aspectFill"></image>
        <view class="draft-cover-placeholder" wx:else>
          <text>📝</text>
        </view>
        <!-- 媒体类型标识 -->
        <view class="media-type-tag" wx:if="{{item.mediaType === 'video'}}">
          <text>🎬</text>
        </view>
      </view>
      
      <!-- 草稿信息 -->
      <view class="draft-info">
        <text class="draft-title">{{item.form.title || '未命名草稿'}}</text>
        <text class="draft-content" wx:if="{{item.form.content}}">{{item.form.content}}</text>
        <view class="draft-meta">
          <text class="draft-time">保存于 {{item.timeStr}}</text>
          <text class="draft-media-count" wx:if="{{item.mediaType === 'image'}}">{{item.photos.length}}张图片</text>
          <text class="draft-media-count" wx:if="{{item.mediaType === 'video'}}">1个视频</text>
        </view>
      </view>
      
      <!-- 删除按钮 -->
      <view class="draft-delete" catchtap="deleteDraft" data-index="{{index}}">
        <text>删除</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <text class="empty-icon">📝</text>
    <text class="empty-text">暂无草稿</text>
    <text class="empty-tip">发布动态时可以保存草稿哦</text>
    <view class="empty-btn" bindtap="goPublish">去发布</view>
  </view>
</view>
