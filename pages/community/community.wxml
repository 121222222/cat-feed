<view class="page-container">
  <!-- 顶部Tab -->
  <view class="comm-tabs">
    <view class="comm-tab {{activeTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">🤝 互助</view>
    <view class="comm-tab {{activeTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">💬 交流</view>
    <view class="comm-tab {{activeTab === 2 ? 'active' : ''}}" bindtap="switchTab" data-tab="2">📋 公告</view>
  </view>

  <!-- 互助板块 -->
  <view class="tab-content" wx:if="{{activeTab === 0}}">
    <!-- 互助入口 -->
    <view class="help-entry">
      <view class="help-card help-need" bindtap="goPublishHelp" data-type="need">
        <view class="help-icon-wrap need-bg">
          <text class="help-icon">🙋</text>
        </view>
        <view class="help-info">
          <text class="help-title">我需要帮助</text>
          <text class="help-desc">出差/假期，求邻居帮忙喂猫</text>
        </view>
        <text class="help-arrow">›</text>
      </view>
      <view class="help-card help-offer" bindtap="goPublishHelp" data-type="offer">
        <view class="help-icon-wrap offer-bg">
          <text class="help-icon">🐾</text>
        </view>
        <view class="help-info">
          <text class="help-title">我可以帮忙</text>
          <text class="help-desc">有空帮邻居喂猫，认识更多喵友</text>
        </view>
        <text class="help-arrow">›</text>
      </view>
    </view>

    <!-- 分类筛选 -->
    <view class="help-filter">
      <view class="filter-item {{helpFilter === 'all' ? 'active' : ''}}" bindtap="setHelpFilter" data-filter="all">全部</view>
      <view class="filter-item {{helpFilter === 'need' ? 'active' : ''}}" bindtap="setHelpFilter" data-filter="need">求助中</view>
      <view class="filter-item {{helpFilter === 'offer' ? 'active' : ''}}" bindtap="setHelpFilter" data-filter="offer">可帮忙</view>
    </view>

    <!-- 互助列表 -->
    <view class="help-list">
      <view class="help-item" wx:for="{{helpList}}" wx:key="id" bindtap="goHelpDetail" data-id="{{item.id}}">
        <view class="help-item-header">
          <view class="help-type-tag {{item.type === 'need' ? 'tag-need' : 'tag-offer'}}">
            {{item.type === 'need' ? '求助' : '可帮忙'}}
          </view>
          <text class="help-item-time">{{item.time}}</text>
        </view>
        <view class="help-item-user">
          <image class="help-user-avatar" src="{{item.userAvatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
          <text class="help-user-name">{{item.userName}}</text>
          <text class="help-user-loc" wx:if="{{item.location}}">📍{{item.location}}</text>
        </view>
        <text class="help-item-title">{{item.title}}</text>
        <text class="help-item-desc">{{item.description}}</text>
        <view class="help-item-tags" wx:if="{{item.dateRange}}">
          <text class="help-date-tag">📅 {{item.dateRange}}</text>
        </view>
        <view class="help-item-footer">
          <view class="help-cat-info" wx:if="{{item.catName}}">
            <image class="help-cat-avatar" src="{{item.catAvatar}}" mode="aspectFill" wx:if="{{item.catAvatar}}"></image>
            <text>{{item.catName}}</text>
          </view>
          <view class="help-action-btn">
            <text>{{item.type === 'need' ? '我来帮忙' : '联系TA'}}</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-help" wx:if="{{helpList.length === 0}}">
        <text class="empty-icon">🤝</text>
        <text class="empty-text">暂无互助信息</text>
        <text class="empty-sub">发布第一条互助信息吧~</text>
      </view>
    </view>
  </view>


  <!-- 交流板块 -->
  <view class="tab-content" wx:if="{{activeTab === 1}}">
    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{postsLoading}}">
      <text class="loading-text">加载中...</text>
    </view>
    
    <!-- 帖子列表 -->
    <block wx:if="{{!postsLoading && posts.length > 0}}">
      <view class="post-card" wx:for="{{posts}}" wx:key="id">
        <view class="post-header">
          <view class="post-user">
            <view class="avatar avatar-sm">
              <image src="{{item.avatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
            </view>
            <view class="post-user-info">
              <text class="post-username">{{item.userName}}</text>
              <text class="post-time">{{item.time}}</text>
            </view>
          </view>
          <!-- 删除按钮（仅作者可见） -->
          <view class="post-delete-btn" wx:if="{{item.isOwner}}" catchtap="deletePost" data-id="{{item.id}}">
            <text>删除</text>
          </view>
        </view>
        <text class="post-content">{{item.content}}</text>
        <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
          <view class="post-img-wrap" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" 
                bindtap="previewImage" data-url="{{img}}" data-urls="{{item.images}}">
            <image src="{{img}}" mode="aspectFill"></image>
          </view>
        </view>
        <view class="post-actions">
          <view class="post-action" catchtap="onLike" data-id="{{item.id}}">
            <image class="action-icon-img {{item.liked ? 'liked-icon' : ''}}" src="/assets/icons/like.png" mode="aspectFit"></image>
            <text>{{item.likes}}</text>
          </view>
          <view class="post-action">
            <image class="action-icon-img" src="/assets/icons/comment.png" mode="aspectFit"></image>
            <text>{{item.comments}}</text>
          </view>
        </view>
      </view>
    </block>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!postsLoading && posts.length === 0}}">
      <text class="empty-icon">💬</text>
      <text class="empty-text">暂无交流内容</text>
      <text class="empty-sub">发布第一条动态吧~</text>
    </view>
    
    <!-- 发帖按钮 -->
    <view class="fab" bindtap="onNewPost">✏️</view>
  </view>

  <!-- 公告板块 -->
  <view class="tab-content" wx:if="{{activeTab === 2}}">
    <view class="rule-card" wx:for="{{rules}}" wx:key="id">
      <view class="rule-header">
        <text class="rule-icon">{{item.icon}}</text>
        <text class="rule-title">{{item.title}}</text>
      </view>
      <text class="rule-content">{{item.content}}</text>
      <text class="rule-time">{{item.time}}</text>
    </view>
  </view>

  <view style="height: 120rpx;"></view>
</view>
