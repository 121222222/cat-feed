/* 互助详情页样式 */
.page-container {
  padding-bottom: 140rpx;
  background: #F8F8F8;
  min-height: 100vh;
}

/* 类型横幅 */
.type-banner {
  padding: 30rpx;
  text-align: center;
}

.type-banner.need-banner {
  background: linear-gradient(135deg, #FFEFE9, #FFD9CE);
}

.type-banner.offer-banner {
  background: linear-gradient(135deg, #E8F8E8, #C8F0C8);
}

.type-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

/* 用户信息 */
.user-section {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  background: #FFFFFF;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #FFEFE9;
  margin-right: 20rpx;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.user-location {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.post-time {
  font-size: 24rpx;
  color: #BBB;
}

/* 内容区域 */
.content-section {
  background: #FFFFFF;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.help-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D2D2D;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.help-desc {
  display: block;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  margin-bottom: 24rpx;
}

/* 信息卡片 */
.info-card {
  background: #FFF7F4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.info-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.info-icon {
  font-size: 32rpx;
  margin-top: 4rpx;
}

.info-content {
  flex: 1;
}

.info-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 6rpx;
}

.info-value {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 猫咪卡片 */
.cat-card {
  background: #FFF7F4;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.cat-header {
  margin-bottom: 16rpx;
}

.cat-title {
  font-size: 26rpx;
  color: #999;
}

.cat-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.cat-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFD9CE;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

/* 联系方式 */
.contact-section {
  background: #FFFFFF;
  padding: 24rpx 30rpx;
  display: flex;
  align-items: center;
}

.contact-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 20rpx;
}

.contact-icon {
  font-size: 28rpx;
}

.contact-title {
  font-size: 28rpx;
  color: #333;
}

.contact-value {
  flex: 1;
  font-size: 28rpx;
  color: #666;
}

.copy-btn {
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
  font-size: 24rpx;
  color: #666;
}

/* 底部操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: #F5F5F5;
  color: #666;
  font-size: 30rpx;
  text-align: center;
}

.btn-primary {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary.full-width {
  flex: 1;
}

.btn-primary:active {
  opacity: 0.85;
}
