<view class="page-container">
  <view class="admin-header">
    <text class="admin-title">👑 管理员后台</text>
    <text class="admin-sub">系统管理与内容审核</text>
  </view>

  <!-- 功能选项卡 -->
  <scroll-view class="tab-scroll" scroll-x enable-flex>
    <view class="tab-bar">
      <view class="tab-item {{activeTab === 'dashboard' ? 'active' : ''}}" bindtap="switchTab" data-tab="dashboard">
        <text class="tab-icon">📊</text>
        <text class="tab-text">数据概览</text>
      </view>
      <view class="tab-item {{activeTab === 'users' ? 'active' : ''}}" bindtap="switchTab" data-tab="users">
        <text class="tab-icon">👥</text>
        <text class="tab-text">用户管理</text>
      </view>
      <view class="tab-item {{activeTab === 'content' ? 'active' : ''}}" bindtap="switchTab" data-tab="content">
        <text class="tab-icon">📝</text>
        <text class="tab-text">内容管理</text>
      </view>
      <view class="tab-item {{activeTab === 'audit' ? 'active' : ''}}" bindtap="switchTab" data-tab="audit">
        <text class="tab-icon">🔍</text>
        <text class="tab-text">审核中心</text>
      </view>
      <view class="tab-item {{activeTab === 'cats' ? 'active' : ''}}" bindtap="switchTab" data-tab="cats">
        <text class="tab-icon">🐱</text>
        <text class="tab-text">猫咪管理</text>
      </view>
      <view class="tab-item {{activeTab === 'rooms' ? 'active' : ''}}" bindtap="switchTab" data-tab="rooms">
        <text class="tab-icon">🏠</text>
        <text class="tab-text">房间号管理</text>
      </view>
      <view class="tab-item {{activeTab === 'settings' ? 'active' : ''}}" bindtap="switchTab" data-tab="settings">
        <text class="tab-icon">⚙️</text>
        <text class="tab-text">系统设置</text>
      </view>
    </view>
  </scroll-view>

  <!-- 1. 数据概览 -->
  <view class="content-section" wx:if="{{activeTab === 'dashboard'}}">
    <view class="section-header">
      <text class="section-title">数据概览</text>
      <text class="section-desc">平台运营数据统计</text>
    </view>

    <!-- 核心数据卡片 -->
    <view class="stats-grid">
      <view class="stat-card orange">
        <text class="stat-value">{{statistics.totalUsers}}</text>
        <text class="stat-label">用户总数</text>
        <text class="stat-sub">今日 +{{statistics.todayUsers}}</text>
      </view>
      <view class="stat-card blue">
        <text class="stat-value">{{statistics.totalPosts}}</text>
        <text class="stat-label">帖子总数</text>
        <text class="stat-sub">今日 +{{statistics.todayPosts}}</text>
      </view>
      <view class="stat-card green">
        <text class="stat-value">{{statistics.totalHelps}}</text>
        <text class="stat-label">互助请求</text>
        <text class="stat-sub">进行中 {{statistics.openHelps}}</text>
      </view>
      <view class="stat-card purple">
        <text class="stat-value">{{statistics.totalCats}}</text>
        <text class="stat-label">猫咪档案</text>
        <text class="stat-sub">已登记</text>
      </view>
    </view>

    <!-- 快捷操作 -->
    <view class="quick-actions">
      <text class="quick-title">快捷操作</text>
      <view class="quick-grid">
        <view class="quick-btn" bindtap="switchTab" data-tab="content">
          <text class="quick-icon">📝</text>
          <text class="quick-text">内容管理</text>
        </view>
        <view class="quick-btn" bindtap="switchTab" data-tab="audit">
          <text class="quick-icon">🔍</text>
          <text class="quick-text">审核中心</text>
        </view>
        <view class="quick-btn" bindtap="switchTab" data-tab="users">
          <text class="quick-icon">👥</text>
          <text class="quick-text">用户管理</text>
        </view>
        <view class="quick-btn" bindtap="publishNotice">
          <text class="quick-icon">📢</text>
          <text class="quick-text">发布通知</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 2. 用户管理 -->
  <view class="content-section" wx:if="{{activeTab === 'users'}}">
    <view class="section-header">
      <text class="section-title">用户管理</text>
      <text class="section-desc">管理平台用户</text>
    </view>

    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索用户名..." value="{{userSearchKeyword}}" bindinput="onUserSearchInput" bindconfirm="searchUsers" />
    </view>

    <view class="empty-state" wx:if="{{users.length === 0}}">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无用户数据</text>
    </view>

    <view class="user-list" wx:else>
      <view class="user-item" wx:for="{{users}}" wx:key="_id">
        <image class="user-avatar" src="{{item.avatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="user-info">
          <view class="user-name-row">
            <text class="user-name">{{item.name || '未设置昵称'}}</text>
            <text class="user-tag certified" wx:if="{{item.certified}}">已认证</text>
            <text class="user-tag disabled" wx:if="{{item.disabled}}">已禁用</text>
          </view>
          <text class="user-phone">{{item.phone || '未绑定手机'}}</text>
          <text class="user-time">注册: {{item.createTimeStr}}</text>
        </view>
        <view class="user-actions">
          <view class="action-btn {{item.disabled ? 'enable' : 'disable'}}" bindtap="toggleUserStatus" data-id="{{item._id}}" data-disabled="{{item.disabled}}">
            {{item.disabled ? '启用' : '禁用'}}
          </view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{usersHasMore}}" bindtap="loadMoreUsers">
      <text>加载更多</text>
    </view>
  </view>

  <!-- 3. 内容管理 -->
  <view class="content-section" wx:if="{{activeTab === 'content'}}">
    <view class="section-header">
      <text class="section-title">内容管理</text>
      <text class="section-desc">管理帖子、互助、评论和话题</text>
    </view>

    <!-- 内容子Tab -->
    <view class="sub-tabs">
      <view class="sub-tab {{contentSubTab === 'posts' ? 'active' : ''}}" bindtap="switchContentTab" data-tab="posts">帖子</view>
      <view class="sub-tab {{contentSubTab === 'helps' ? 'active' : ''}}" bindtap="switchContentTab" data-tab="helps">互助</view>
      <view class="sub-tab {{contentSubTab === 'comments' ? 'active' : ''}}" bindtap="switchContentTab" data-tab="comments">评论</view>
      <view class="sub-tab {{contentSubTab === 'topics' ? 'active' : ''}}" bindtap="switchContentTab" data-tab="topics">话题</view>
    </view>

    <!-- 帖子管理 -->
    <block wx:if="{{contentSubTab === 'posts'}}">
      <view class="search-bar">
        <text class="search-icon">🔍</text>
        <input class="search-input" placeholder="搜索帖子..." value="{{postSearchKeyword}}" bindinput="onPostSearchInput" bindconfirm="searchPosts" />
      </view>

      <view class="empty-state" wx:if="{{posts.length === 0}}">
        <text class="empty-icon">📭</text>
        <text class="empty-text">暂无帖子</text>
      </view>

      <view class="post-list" wx:else>
        <view class="post-item" wx:for="{{posts}}" wx:key="_id">
          <view class="post-header">
            <image class="post-avatar" src="{{item.userAvatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="post-user-info">
              <text class="post-username">{{item.userName || '匿名用户'}}</text>
              <text class="post-time">{{item.createTimeStr}}</text>
            </view>
            <text class="post-top-tag" wx:if="{{item.isTop}}">置顶</text>
          </view>
          <view class="post-content">
            <text class="post-text">{{item.content}}</text>
            <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
              <image class="post-img" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill"></image>
            </view>
          </view>
          <view class="post-stats">
            <text>👍 {{item.likes || 0}}</text>
            <text>💬 {{item.comments || 0}}</text>
            <text>👁️ {{item.views || 0}}</text>
          </view>
          <view class="post-actions">
            <view class="action-btn primary" bindtap="togglePostTop" data-id="{{item._id}}" data-top="{{item.isTop}}">
              {{item.isTop ? '取消置顶' : '置顶'}}
            </view>
            <view class="action-btn danger" bindtap="deletePost" data-id="{{item._id}}" data-index="{{index}}">
              删除
            </view>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{postsHasMore}}" bindtap="loadMorePosts">
        <text>加载更多</text>
      </view>
    </block>

    <!-- 互助管理 -->
    <block wx:if="{{contentSubTab === 'helps'}}">
      <view class="filter-tabs">
        <view class="filter-tab {{helpFilter === 'all' ? 'active' : ''}}" bindtap="setHelpFilter" data-filter="all">全部</view>
        <view class="filter-tab {{helpFilter === 'open' ? 'active' : ''}}" bindtap="setHelpFilter" data-filter="open">进行中</view>
        <view class="filter-tab {{helpFilter === 'closed' ? 'active' : ''}}" bindtap="setHelpFilter" data-filter="closed">已完成</view>
      </view>

      <view class="empty-state" wx:if="{{helps.length === 0}}">
        <text class="empty-icon">🤝</text>
        <text class="empty-text">暂无互助请求</text>
      </view>

      <view class="help-list" wx:else>
        <view class="help-item" wx:for="{{helps}}" wx:key="_id">
          <view class="help-header">
            <text class="help-type {{item.type}}">{{item.type === 'feed' ? '喂养' : item.type === 'foster' ? '寄养' : '其他'}}</text>
            <text class="help-status {{item.status}}">{{item.status === 'open' ? '进行中' : '已完成'}}</text>
          </view>
          <text class="help-title">{{item.title}}</text>
          <text class="help-desc">{{item.description}}</text>
          <view class="help-footer">
            <text class="help-time">{{item.createTimeStr}}</text>
            <view class="help-actions">
              <view class="action-btn warning" wx:if="{{item.status === 'open'}}" bindtap="closeHelp" data-id="{{item._id}}">关闭</view>
              <view class="action-btn danger" bindtap="deleteHelp" data-id="{{item._id}}" data-index="{{index}}">删除</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 评论管理 -->
    <block wx:if="{{contentSubTab === 'comments'}}">
      <view class="empty-state" wx:if="{{comments.length === 0}}">
        <text class="empty-icon">💬</text>
        <text class="empty-text">暂无评论</text>
      </view>

      <view class="comment-list" wx:else>
        <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
          <view class="comment-header">
            <image class="comment-avatar" src="{{item.userAvatar || '/assets/icons/default-avatar.png'}}" mode="aspectFill"></image>
            <view class="comment-user">
              <text class="comment-name">{{item.userName || '匿名'}}</text>
              <text class="comment-time">{{item.createTimeStr}}</text>
            </view>
          </view>
          <text class="comment-content">{{item.content}}</text>
          <view class="comment-actions">
            <view class="action-btn danger" bindtap="deleteComment" data-id="{{item._id}}" data-postid="{{item.postId}}" data-index="{{index}}">删除</view>
          </view>
        </view>
      </view>
    </block>

    <!-- 话题管理 -->
    <block wx:if="{{contentSubTab === 'topics'}}">
      <view class="add-topic-row">
        <input class="topic-input" placeholder="输入话题名称" value="{{newTopicName}}" bindinput="onTopicInput" />
        <view class="add-topic-btn" bindtap="addTopic">添加</view>
      </view>

      <view class="empty-state" wx:if="{{topics.length === 0}}">
        <text class="empty-icon">#</text>
        <text class="empty-text">暂无话题</text>
      </view>

      <view class="topic-list" wx:else>
        <view class="topic-item" wx:for="{{topics}}" wx:key="_id">
          <text class="topic-name">#{{item.name}}</text>
          <view class="action-btn danger small" bindtap="deleteTopic" data-id="{{item._id}}" data-index="{{index}}">删除</view>
        </view>
      </view>
    </block>
  </view>

  <!-- 4. 审核中心 -->
  <view class="content-section" wx:if="{{activeTab === 'audit'}}">
    <view class="section-header">
      <text class="section-title">审核中心</text>
      <text class="section-desc">处理用户举报和内容审核</text>
    </view>

    <!-- 发布系统通知 -->
    <view class="notice-card">
      <view class="notice-header">
        <text class="notice-title">📢 发布系统通知</text>
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="通知标题" value="{{noticeTitle}}" bindinput="onNoticeTitleInput" maxlength="30" />
      </view>
      <view class="form-group">
        <textarea class="form-textarea" placeholder="通知内容..." value="{{noticeContent}}" bindinput="onNoticeContentInput" maxlength="500"></textarea>
      </view>
      <view class="btn-primary" bindtap="publishNotice">发布通知</view>
    </view>

    <!-- 举报列表 -->
    <view class="report-section">
      <view class="report-header">
        <text class="report-title">📋 举报处理</text>
        <view class="filter-tabs small">
          <view class="filter-tab {{reportFilter === 'pending' ? 'active' : ''}}" bindtap="setReportFilter" data-filter="pending">待处理</view>
          <view class="filter-tab {{reportFilter === 'handled' ? 'active' : ''}}" bindtap="setReportFilter" data-filter="handled">已处理</view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{reports.length === 0}}">
        <text class="empty-icon">✅</text>
        <text class="empty-text">暂无举报</text>
      </view>

      <view class="report-list" wx:else>
        <view class="report-item" wx:for="{{reports}}" wx:key="_id">
          <view class="report-info">
            <text class="report-type">{{item.type === 'post' ? '帖子举报' : item.type === 'comment' ? '评论举报' : '用户举报'}}</text>
            <text class="report-reason">原因: {{item.reason}}</text>
            <text class="report-time">{{item.createTimeStr}}</text>
          </view>
          <view class="report-actions" wx:if="{{item.status === 'pending'}}">
            <view class="action-btn success" bindtap="handleReport" data-id="{{item._id}}" data-result="ignore">忽略</view>
            <view class="action-btn danger" bindtap="handleReport" data-id="{{item._id}}" data-result="delete">删除内容</view>
          </view>
          <text class="report-result" wx:else>处理结果: {{item.result === 'ignore' ? '已忽略' : '已删除'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 5. 猫咪档案管理 -->
  <view class="content-section" wx:if="{{activeTab === 'cats'}}">
    <view class="section-header">
      <text class="section-title">猫咪档案管理</text>
      <text class="section-desc">管理已登记的猫咪档案</text>
    </view>

    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索猫咪名..." value="{{catSearchKeyword}}" bindinput="onCatSearchInput" bindconfirm="searchCats" />
    </view>

    <view class="empty-state" wx:if="{{cats.length === 0}}">
      <text class="empty-icon">🐱</text>
      <text class="empty-text">暂无猫咪档案</text>
    </view>

    <view class="cat-list" wx:else>
      <view class="cat-item" wx:for="{{cats}}" wx:key="_id">
        <image class="cat-avatar" src="{{item.avatar || '/assets/icons/default-cat.png'}}" mode="aspectFill"></image>
        <view class="cat-info">
          <text class="cat-name">{{item.name}}</text>
          <text class="cat-detail">{{item.breed || '未知品种'}} · {{item.gender === 'male' ? '公' : '母'}} · {{item.age || '未知'}}岁</text>
          <text class="cat-owner">主人: {{item.ownerName || '未知'}}</text>
        </view>
        <view class="cat-actions">
          <view class="action-btn danger" bindtap="deleteCat" data-id="{{item._id}}" data-index="{{index}}">删除</view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{catsHasMore}}" bindtap="loadMoreCats">
      <text>加载更多</text>
    </view>
  </view>

  <!-- 6. 房间号管理 -->
  <view class="content-section" wx:if="{{activeTab === 'rooms'}}">
    <view class="section-header">
      <text class="section-title">房间号管理</text>
      <text class="section-desc">管理有效的公寓房间号</text>
    </view>

    <!-- 房间号统计 -->
    <view class="room-stats">
      <view class="room-stat-item">
        <text class="room-stat-value">{{roomStatistics.totalRooms}}</text>
        <text class="room-stat-label">总房间数</text>
      </view>
      <view class="room-stat-item">
        <text class="room-stat-value">{{roomStatistics.activeRooms}}</text>
        <text class="room-stat-label">有效房间</text>
      </view>
      <view class="room-stat-item">
        <text class="room-stat-value">{{roomStatistics.boundRooms}}</text>
        <text class="room-stat-label">已绑定</text>
      </view>
    </view>

    <!-- 一键初始化所有房间号 -->
    <view class="settings-card">
      <view class="settings-header">
        <text class="settings-title">🚀 一键初始化</text>
      </view>
      <view class="init-desc">
        <text>点击下方按钮将自动添加1-11栋所有房间号。已存在的房间号会自动跳过，不会重复添加。</text>
      </view>
      <view class="btn-primary {{initRoomsLoading ? 'disabled' : ''}}" bindtap="initAllRooms">
        {{initRoomsLoading ? '初始化中...' : '一键初始化所有房间号'}}
      </view>
    </view>

    <!-- 批量添加 -->
    <view class="settings-card">
      <view class="settings-header">
        <text class="settings-title">➕ 批量添加房间号</text>
      </view>
      <view class="form-group">
        <text class="form-label">选择楼栋</text>
        <picker class="building-select" mode="selector" range="{{buildingOptions}}" value="{{batchBuildingIndex}}" bindchange="onBatchBuildingChange">
          <view class="picker-box">
            {{batchBuildingIndex >= 0 ? buildingOptions[batchBuildingIndex] : '请选择楼栋'}}
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="form-group">
        <text class="form-label">房间号（多个用逗号分隔）</text>
        <textarea class="form-textarea" placeholder="如：101,102,103,201,202" value="{{batchRoomNumbers}}" bindinput="onBatchRoomInput"></textarea>
      </view>
      <view class="btn-primary" bindtap="batchAddRooms">批量添加</view>
    </view>

    <!-- 房间号列表 -->
    <view class="settings-card">
      <view class="settings-header">
        <text class="settings-title">📋 房间号列表</text>
        <picker mode="selector" range="{{roomFilterOptions}}" value="{{roomFilterIndex}}" bindchange="onRoomFilterChange">
          <view class="filter-btn">{{roomFilterOptions[roomFilterIndex]}} ▼</view>
        </picker>
      </view>
      
      <view class="empty-state small" wx:if="{{validRooms.length === 0}}">
        <text class="empty-text">暂无房间号数据</text>
      </view>
      
      <view class="room-list" wx:else>
        <view class="room-item" wx:for="{{validRooms}}" wx:key="_id">
          <view class="room-info">
            <text class="room-name">{{item.building}} {{item.roomNumber}}</text>
            <text class="room-status {{item.status === 'active' ? 'active' : 'inactive'}}">
              {{item.status === 'active' ? '有效' : '已禁用'}}
            </text>
          </view>
          <view class="room-actions">
            <view class="action-btn small {{item.status === 'active' ? 'warning' : 'success'}}" 
                  bindtap="toggleRoomStatus" 
                  data-id="{{item._id}}" 
                  data-status="{{item.status}}">
              {{item.status === 'active' ? '禁用' : '启用'}}
            </view>
            <view class="action-btn danger small" bindtap="deleteRoom" data-id="{{item._id}}" data-index="{{index}}">删除</view>
          </view>
        </view>
      </view>
      
      <view class="load-more" wx:if="{{roomsHasMore}}" bindtap="loadMoreRooms">
        <text>加载更多</text>
      </view>
    </view>

    <!-- 解绑用户房间号 -->
    <view class="settings-card">
      <view class="settings-header">
        <text class="settings-title">🔓 解绑用户房间号</text>
      </view>
      <view class="form-group">
        <text class="form-label">用户手机号</text>
        <input class="form-input" type="number" placeholder="输入要解绑的用户手机号" value="{{unbindPhone}}" bindinput="onUnbindPhoneInput" maxlength="11" />
      </view>
      <view class="btn-primary warning" bindtap="unbindUserRoom">解绑房间号</view>
    </view>
  </view>

  <!-- 7. 系统设置 -->
  <view class="content-section" wx:if="{{activeTab === 'settings'}}">
    <view class="section-header">
      <text class="section-title">系统设置</text>
      <text class="section-desc">配置小程序基础设置</text>
    </view>

    <!-- 轮播图管理 -->
    <view class="settings-card">
      <view class="settings-header">
        <text class="settings-title">🖼️ 轮播图管理</text>
      </view>
      <view class="banner-list">
        <view class="banner-item" wx:for="{{banners}}" wx:key="index">
          <image class="banner-img" src="{{item.image}}" mode="aspectFill"></image>
          <view class="banner-actions">
            <view class="action-btn danger small" bindtap="deleteBanner" data-index="{{index}}">删除</view>
          </view>
        </view>
        <view class="add-banner" bindtap="addBanner">
          <text class="add-icon">+</text>
          <text class="add-text">添加轮播图</text>
        </view>
      </view>
    </view>

    <!-- 社区公告管理 -->
    <view class="settings-card">
      <view class="settings-header">
        <text class="settings-title">📋 社区公告</text>
      </view>
      <view class="form-group">
        <input class="form-input" placeholder="公告标题" value="{{announcementTitle}}" bindinput="onAnnouncementTitleInput" maxlength="30" />
      </view>
      <view class="form-group">
        <textarea class="form-textarea" placeholder="公告内容..." value="{{announcementContent}}" bindinput="onAnnouncementContentInput" maxlength="500"></textarea>
      </view>
      <view class="btn-primary" bindtap="publishAnnouncement">发布公告</view>

      <view class="announcement-list" wx:if="{{announcements.length > 0}}">
        <view class="announcement-item" wx:for="{{announcements}}" wx:key="id">
          <view class="announcement-content">
            <text class="announcement-title">{{item.title}}</text>
            <text class="announcement-time">{{item.createTime}}</text>
          </view>
          <view class="action-btn danger small" bindtap="deleteAnnouncement" data-id="{{item.id}}">删除</view>
        </view>
      </view>
    </view>

    <!-- 操作日志 -->
    <view class="settings-card">
      <view class="settings-header">
        <text class="settings-title">📜 操作日志</text>
      </view>
      <view class="empty-state small" wx:if="{{logs.length === 0}}">
        <text class="empty-text">暂无操作记录</text>
      </view>
      <view class="log-list" wx:else>
        <view class="log-item" wx:for="{{logs}}" wx:key="_id">
          <text class="log-action">{{item.action}}</text>
          <text class="log-time">{{item.createTimeStr}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-btn" bindtap="logout">
    <text>退出管理后台</text>
  </view>
</view>
