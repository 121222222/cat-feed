/* 管理员后台样式 */
.page-container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 120rpx;
}

.admin-header {
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  padding: 60rpx 30rpx 40rpx;
  text-align: center;
}

.admin-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.admin-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: #FFFFFF;
  padding: 20rpx 10rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FFF0EB, #FFE8E2);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 24rpx;
  color: #666;
}

.tab-item.active .tab-text {
  color: #FF8A6B;
  font-weight: 600;
}

/* 内容区域 */
.content-section {
  padding: 30rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.section-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 表单 */
.form-group {
  margin-bottom: 30rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F0F0F0;
}

.form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 8rpx;
}

.btn-primary {
  padding: 26rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 66, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* 列表 */
.list-section {
  margin-top: 40rpx;
}

.list-header {
  margin-bottom: 20rpx;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.item-content {
  flex: 1;
}

.item-title {
  display: block;
  font-size: 28rpx;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.item-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.item-actions .action-btn {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

.item-actions .delete {
  color: #FF4D4F;
  background: #FFF2F0;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  border-radius: 50rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 帖子列表 */
.post-list {
  margin-top: 20rpx;
}

.post-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #F0F0F0;
}

.post-user-info {
  flex: 1;
}

.post-username {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #2D2D2D;
}

.post-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-content {
  margin-bottom: 16rpx;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.post-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #F0F0F0;
}

.post-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
}

.post-actions .action-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
}

.post-actions .action-btn.danger {
  background: #FFF2F0;
  color: #FF4D4F;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 退出按钮 */
.logout-btn {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 60rpx;
  background: #FFFFFF;
  border: 2rpx solid #DDD;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #666;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.logout-btn:active {
  background: #F5F5F5;
}
