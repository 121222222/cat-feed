/* 管理员后台样式 */
.page-container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 120rpx;
}

.admin-header {
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  padding: 60rpx 30rpx 40rpx;
  text-align: center;
}

.admin-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}

.admin-sub {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* Tab栏 - 可滚动 */
.tab-scroll {
  background: #FFFFFF;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tab-bar {
  display: inline-flex;
  padding: 20rpx 10rpx;
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  transition: all 0.3s;
  min-width: 120rpx;
}

.tab-item.active {
  background: linear-gradient(135deg, #FFF0EB, #FFE8E2);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.tab-text {
  font-size: 24rpx;
  color: #666;
  white-space: nowrap;
}

.tab-item.active .tab-text {
  color: #FF8A6B;
  font-weight: 600;
}

/* 内容区域 */
.content-section {
  padding: 30rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.section-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* ========== 数据概览 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.stat-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  overflow: hidden;
}

.stat-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
}

.stat-card.orange::before { background: linear-gradient(90deg, #FF8A6B, #FFB088); }
.stat-card.blue::before { background: linear-gradient(90deg, #4A90E2, #74B9FF); }
.stat-card.green::before { background: linear-gradient(90deg, #52C41A, #95DE64); }
.stat-card.purple::before { background: linear-gradient(90deg, #9B59B6, #BE90D4); }

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.stat-sub {
  display: block;
  font-size: 22rpx;
  color: #999;
}

/* 快捷操作 */
.quick-actions {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.quick-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 24rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #F8F8F8;
  border-radius: 16rpx;
}

.quick-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.quick-text {
  font-size: 22rpx;
  color: #666;
}

/* ========== 通用搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20rpx 24rpx;
  border-radius: 50rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

/* ========== 子Tab和筛选 ========== */
.sub-tabs {
  display: flex;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.sub-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.sub-tab.active {
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  color: #FFFFFF;
  font-weight: 500;
}

.filter-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.filter-tabs.small {
  margin-bottom: 0;
}

.filter-tab {
  padding: 12rpx 24rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.filter-tab.active {
  background: #FFE8E2;
  color: #FF8A6B;
}

/* ========== 用户列表 ========== */
.user-list {
  margin-top: 20rpx;
}

.user-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  background: #F0F0F0;
}

.user-info {
  flex: 1;
}

.user-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2D2D;
}

.user-tag {
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
}

.user-tag.certified {
  background: #E6F7FF;
  color: #1890FF;
}

.user-tag.disabled {
  background: #FFF2F0;
  color: #FF4D4F;
}

.user-phone {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.user-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.user-actions {
  margin-left: 16rpx;
}

/* ========== 帖子列表 ========== */
.post-list {
  margin-top: 20rpx;
}

.post-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #F0F0F0;
}

.post-user-info {
  flex: 1;
}

.post-username {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #2D2D2D;
}

.post-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.post-top-tag {
  padding: 6rpx 16rpx;
  background: #FF8A6B;
  color: #FFFFFF;
  font-size: 20rpx;
  border-radius: 20rpx;
}

.post-content {
  margin-bottom: 16rpx;
}

.post-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.post-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #F0F0F0;
}

.post-stats {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.post-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
}

/* ========== 互助列表 ========== */
.help-list {
  margin-top: 20rpx;
}

.help-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.help-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.help-type {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #FFF0EB;
  color: #FF8A6B;
}

.help-status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.help-status.open {
  background: #E6F7FF;
  color: #1890FF;
}

.help-status.closed {
  background: #F6FFED;
  color: #52C41A;
}

.help-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #2D2D2D;
  margin-bottom: 8rpx;
}

.help-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.help-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5F5F5;
}

.help-time {
  font-size: 22rpx;
  color: #999;
}

.help-actions {
  display: flex;
  gap: 12rpx;
}

/* ========== 评论列表 ========== */
.comment-list {
  margin-top: 20rpx;
}

.comment-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.comment-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #F0F0F0;
}

.comment-user {
  flex: 1;
}

.comment-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #2D2D2D;
}

.comment-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  display: block;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.comment-actions {
  display: flex;
  justify-content: flex-end;
}

/* ========== 话题管理 ========== */
.add-topic-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.topic-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.add-topic-btn {
  padding: 0 40rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
}

.topic-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.topic-name {
  font-size: 26rpx;
  color: #666;
}

/* ========== 审核中心 ========== */
.notice-card, .report-section, .settings-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.notice-header, .report-header, .settings-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.notice-title, .report-title, .settings-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.report-list {
  margin-top: 16rpx;
}

.report-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.report-item:last-child {
  border-bottom: none;
}

.report-info {
  flex: 1;
}

.report-type {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #2D2D2D;
  margin-bottom: 4rpx;
}

.report-reason {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.report-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.report-actions {
  display: flex;
  gap: 12rpx;
}

.report-result {
  font-size: 24rpx;
  color: #999;
}

/* ========== 猫咪列表 ========== */
.cat-list {
  margin-top: 20rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.cat-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 20rpx;
  background: #F0F0F0;
}

.cat-info {
  flex: 1;
}

.cat-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 6rpx;
}

.cat-detail {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.cat-owner {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.cat-actions {
  margin-left: 16rpx;
}

/* ========== 系统设置 ========== */
.banner-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.banner-item {
  position: relative;
  width: calc(50% - 8rpx);
}

.banner-img {
  width: 100%;
  height: 160rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
}

.banner-actions {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
}

.add-banner {
  width: calc(50% - 8rpx);
  height: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F8F8F8;
  border: 2rpx dashed #DDD;
  border-radius: 12rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #CCC;
}

.add-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.announcement-list {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F5F5F5;
}

.announcement-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.announcement-item:last-child {
  border-bottom: none;
}

.announcement-content {
  flex: 1;
}

.announcement-title {
  display: block;
  font-size: 28rpx;
  color: #2D2D2D;
  margin-bottom: 4rpx;
}

.announcement-time {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.log-list {
  max-height: 400rpx;
  overflow-y: auto;
}

.log-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.log-item:last-child {
  border-bottom: none;
}

.log-action {
  font-size: 26rpx;
  color: #333;
}

.log-time {
  font-size: 22rpx;
  color: #999;
}

/* ========== 表单 ========== */
.form-group {
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.btn-primary {
  padding: 26rpx;
  border-radius: 50rpx;
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 66, 0.3);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ========== 通用按钮 ========== */
.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.small {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.action-btn.primary {
  background: #E6F7FF;
  color: #1890FF;
}

.action-btn.success {
  background: #F6FFED;
  color: #52C41A;
}

.action-btn.warning {
  background: #FFFBE6;
  color: #FAAD14;
}

.action-btn.danger {
  background: #FFF2F0;
  color: #FF4D4F;
}

.action-btn.disable {
  background: #FFF2F0;
  color: #FF4D4F;
}

.action-btn.enable {
  background: #F6FFED;
  color: #52C41A;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-state.small {
  padding: 40rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
  font-size: 26rpx;
  color: #999;
}

/* 退出按钮 */
.logout-btn {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
  padding: 20rpx 60rpx;
  background: #FFFFFF;
  border: 2rpx solid #DDD;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #666;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.logout-btn:active {
  background: #F5F5F5;
}

/* ========== 房间号管理 ========== */
.room-stats {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.room-stat-item {
  flex: 1;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.room-stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FF8A6B;
}

.room-stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.building-select {
  width: 100%;
}

.picker-box {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.filter-btn {
  padding: 10rpx 20rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.room-list {
  margin-top: 16rpx;
}

.room-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.room-item:last-child {
  border-bottom: none;
}

.room-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.room-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.room-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.room-status.active {
  background: #F6FFED;
  color: #52C41A;
}

.room-status.inactive {
  background: #FFF2F0;
  color: #FF4D4F;
}

.room-actions {
  display: flex;
  gap: 12rpx;
}

.btn-primary.warning {
  background: linear-gradient(135deg, #FAAD14, #FFC53D);
  box-shadow: 0 8rpx 24rpx rgba(250, 173, 20, 0.3);
}
