<view class="page-container">
  <!-- 作者信息 -->
  <view class="author-section">
    <image class="author-avatar" src="{{post.userAvatar}}" mode="aspectFill"></image>
    <view class="author-info">
      <text class="author-name">{{post.userName}}</text>
      <text class="post-time">{{post.time || '刚刚'}}</text>
    </view>
    <view class="follow-btn" wx:if="{{!isOwner}}">+ 关注</view>
    <!-- 更多按钮 -->
    <view class="more-btn" bindtap="showMoreMenu">
      <text class="more-icon">•••</text>
    </view>
  </view>

  <!-- 更多操作弹窗 -->
  <view class="action-sheet-mask" wx:if="{{showActionSheet}}" bindtap="hideMoreMenu"></view>
  <view class="action-sheet {{showActionSheet ? 'show' : ''}}">
    <view class="action-sheet-content">
      <view class="action-sheet-item" bindtap="onSaveImage">
        <text class="action-sheet-icon">💾</text>
        <text class="action-sheet-text">保存图片</text>
      </view>
      <view class="action-sheet-item" bindtap="onEditPost" wx:if="{{isOwner}}">
        <text class="action-sheet-icon">✏️</text>
        <text class="action-sheet-text">编辑</text>
      </view>
      <view class="action-sheet-item" bindtap="onSetVisibility" wx:if="{{isOwner}}">
        <text class="action-sheet-icon">{{post.visibility === 'private' ? '🔒' : '🌍'}}</text>
        <text class="action-sheet-text">权限设置</text>
        <text class="action-sheet-tag">{{post.visibility === 'private' ? '仅自己' : '公开'}}</text>
      </view>
      <view class="action-sheet-item danger" bindtap="onDeletePost" wx:if="{{isOwner}}">
        <text class="action-sheet-icon">🗑️</text>
        <text class="action-sheet-text">删除</text>
      </view>
      <view class="action-sheet-item" bindtap="onReportPost" wx:if="{{!isOwner}}">
        <text class="action-sheet-icon">⚠️</text>
        <text class="action-sheet-text">举报</text>
      </view>
    </view>
    <view class="action-sheet-cancel" bindtap="hideMoreMenu">取消</view>
  </view>

  <!-- 视频播放区域 -->
  <view class="video-container" wx:if="{{post.mediaType === 'video' && post.videoUrl}}">
    <video 
      class="post-video" 
      src="{{post.videoUrl}}" 
      controls 
      object-fit="contain"
      show-center-play-btn="{{true}}"
      show-play-btn="{{true}}"
      show-fullscreen-btn="{{true}}"
      enable-progress-gesture="{{true}}"
      poster="{{post.videoCover}}"
    ></video>
    <view class="video-duration-tag" wx:if="{{post.videoDuration}}">{{post.videoDurationText}}</view>
  </view>

  <!-- 图片轮播 -->
  <block wx:if="{{post.mediaType !== 'video' && post.images && post.images.length > 0}}">
    <swiper class="image-swiper" indicator-dots="{{post.images.length > 1}}" circular autoplay="{{false}}" style="height: {{swiperHeight}}px;">
      <swiper-item wx:for="{{post.images}}" wx:key="*this">
        <view class="swiper-item-img">
          <image class="post-image" src="{{item}}" mode="widthFix" bindtap="previewImage" data-url="{{item}}" bindload="onImageLoad"></image>
        </view>
      </swiper-item>
    </swiper>
    <view class="image-count" wx:if="{{post.images.length > 1}}">{{currentIndex + 1}}/{{post.images.length}}</view>
  </block>

  <!-- 内容区域 -->
  <view class="content-section">
    <text class="post-title">{{post.title}}</text>
    <text class="post-content">{{post.content}}</text>
    
    <!-- 话题标签 -->
    <view class="topic-tags" wx:if="{{post.topics && post.topics.length > 0}}">
      <text class="topic-tag" wx:for="{{post.topics}}" wx:key="*this">#{{item}}</text>
    </view>

    <!-- 关联猫咪 -->
    <view class="cat-info" wx:if="{{post.catName}}" bindtap="goCatDetail">
      <image class="cat-avatar" src="{{post.catAvatar}}" mode="aspectFill" wx:if="{{post.catAvatar}}"></image>
      <text class="cat-name">🐱 {{post.catName}}</text>
    </view>
  </view>

  <!-- 互动栏 -->
  <view class="action-bar">
    <view class="action-item {{post.liked ? 'liked' : ''}}" bindtap="onLike">
      <image class="action-icon-img {{post.liked ? 'liked-icon' : ''}}" src="/assets/icons/like.png" mode="aspectFit"></image>
      <text class="action-text">{{post.likes || 0}}</text>
    </view>
    <view class="action-item" bindtap="showCommentPanel">
      <image class="action-icon-img" src="/assets/icons/comment.png" mode="aspectFit"></image>
      <text class="action-text">{{post.comments || 0}}</text>
    </view>
    <button class="action-item share-btn" open-type="share">
      <image class="action-icon-img" src="/assets/icons/share.png" mode="aspectFit"></image>
      <text class="action-text">分享</text>
    </button>
  </view>


  <!-- 评论区域 -->
  <view class="comment-section">
    <view class="section-title">评论 ({{post.comments || 0}})</view>
    
    <!-- 评论列表 -->
    <view class="comment-list" wx:if="{{comments && comments.length > 0}}">
      <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
        <image class="comment-avatar" src="{{item.userAvatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
        <view class="comment-content">
          <view class="comment-header">
            <text class="comment-name">{{item.userName}}</text>
            <text class="comment-time">{{item.time || '刚刚'}}</text>
          </view>
          <text class="comment-text">{{item.content}}</text>
        </view>
      </view>
    </view>
    
    <view class="empty-comment" wx:if="{{!comments || comments.length === 0}}">
      <text>暂无评论，快来抢沙发~</text>
    </view>
  </view>

  <!-- 底部评论入口（未聚焦时显示） -->
  <view class="comment-bar-trigger safe-bottom" wx:if="{{!showCommentInput}}" bindtap="showCommentPanel">
    <view class="trigger-input-fake">
      <text class="trigger-placeholder">说点什么...</text>
    </view>
    <view class="trigger-send-btn">发送</view>
  </view>

  <!-- 底部评论输入栏（聚焦时显示，跟随键盘） -->
  <view class="comment-input-bar safe-bottom" wx:if="{{showCommentInput}}">
    <input 
      class="comment-input-field" 
      placeholder="说点什么..." 
      value="{{commentText}}" 
      bindinput="onCommentInput"
      focus="{{showCommentInput}}"
      bindblur="hideCommentPanel"
      confirm-type="send"
      bindconfirm="sendComment"
      adjust-position="{{true}}"
      cursor-spacing="10"
      maxlength="500"
    />
    <view class="comment-send-btn {{commentText ? 'active' : ''}}" bindtap="sendComment">发送</view>
  </view>
</view>
