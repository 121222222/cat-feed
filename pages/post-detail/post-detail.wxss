/* 动态详情页样式 */
.page-container {
  padding-bottom: 120rpx;
  background: #FFFFFF;
  min-height: 100vh;
}

/* 作者信息 */
.author-section {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #FFEFE9;
  margin-right: 16rpx;
}

.author-info {
  flex: 1;
}

.author-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.post-time {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.follow-btn {
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

/* 视频播放区域 */
.video-container {
  position: relative;
  width: 100%;
  background: #000;
}

.post-video {
  width: 100%;
  height: 500rpx;
}

.video-duration-tag {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(0,0,0,0.6);
  color: #FFF;
  font-size: 24rpx;
}

/* 图片轮播 */
.image-swiper {
  width: 100%;
  height: auto;
  min-height: 400rpx;
  background: #F8F8F8;
}

.swiper-item-img {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-image {
  width: 100%;
  max-height: 1000rpx;
}

.image-count {
  text-align: center;
  padding: 12rpx;
  font-size: 24rpx;
  color: #999;
}

/* 内容区域 */
.content-section {
  padding: 24rpx 30rpx;
}

.post-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #2D2D2D;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.post-content {
  display: block;
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  white-space: pre-wrap;
  margin-bottom: 20rpx;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.topic-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #E8F4FD;
  font-size: 24rpx;
  color: #1890FF;
}

.cat-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: #FFF7F4;
  border-radius: 12rpx;
}

.cat-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FFD9CE;
}

.cat-name {
  font-size: 26rpx;
  color: #FFBAA3;
}

/* 互动栏 */
.action-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx 30rpx;
  border-top: 1rpx solid #F5F5F5;
  border-bottom: 1rpx solid #F5F5F5;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  transition: all 0.2s ease;
}

.action-item.share-btn {
  background: transparent;
  border: none;
  margin: 0;
  line-height: normal;
}

.action-item.share-btn::after {
  display: none;
}

.action-item:active {
  background: #F8F8F8;
}

.action-item.liked {
  color: #EFAA97;
}

.action-icon {
  font-size: 36rpx;
}

.action-icon-img {
  width: 40rpx;
  height: 40rpx;
  transition: filter 0.2s ease;
}

.action-icon-img.liked-icon,
.action-item.liked .action-icon-img {
  filter: brightness(0) saturate(100%) invert(76%) sepia(25%) saturate(747%) hue-rotate(334deg) brightness(97%) contrast(92%);
}

.action-text {
  font-size: 26rpx;
  color: #666;
}

.action-item.liked .action-text {
  color: #EFAA97;
}

/* 评论区域 */
.comment-section {
  padding: 24rpx 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.empty-comment {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 26rpx;
}

/* 评论列表 */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFEFE9;
  flex-shrink: 0;
}

.comment-content {
  flex: 1;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #BBB;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 底部评论入口 */
.comment-bar-trigger {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.trigger-input-fake {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
}

.trigger-placeholder {
  font-size: 28rpx;
  color: #999;
}

.trigger-send-btn {
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  background: #E0E0E0;
  color: #999;
  font-size: 28rpx;
  font-weight: 500;
}

/* 底部评论输入栏（跟随键盘） */
.comment-input-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.comment-input-field {
  flex: 1;
  padding: 20rpx 24rpx;
  background: #F5F5F5;
  border-radius: 30rpx;
  font-size: 28rpx;
  color: #333;
}

.comment-send-btn {
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  background: #E0E0E0;
  color: #999;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.comment-send-btn.active {
  background: linear-gradient(135deg, #FFBAA3, #EFAA97);
  color: #FFFFFF;
}

/* 分享面板遮罩 */
.share-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 998;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.share-panel-mask.show {
  opacity: 1;
  visibility: visible;
}

/* 分享面板 */
.share-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 30rpx 30rpx 0 0;
  z-index: 999;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  padding-bottom: env(safe-area-inset-bottom);
}

.share-panel.show {
  transform: translateY(0);
}

.share-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.share-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.share-panel-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
  padding: 0 10rpx;
}

/* 分享选项 - 横向滚动 */
.share-options {
  width: 100%;
  white-space: nowrap;
  padding: 32rpx 0;
}

.share-options-inner {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 40rpx;
}

.share-option {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  margin: 0;
  margin-left: 0 !important;
  margin-right: 0 !important;
  background: transparent;
  border: none;
  line-height: normal;
  width: 140rpx;
  min-width: 140rpx;
}

.share-option::after {
  display: none;
}

.share-icon-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.share-icon-svg {
  width: 48rpx;
  height: 48rpx;
}

.wechat-bg {
  background: #07C160;
}

.moments-bg {
  background: #F76C6C;
}

.link-bg {
  background: #1296DB;
}

.save-bg {
  background: #FFB347;
}

.share-name {
  font-size: 24rpx;
  color: #666;
}

.share-cancel {
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
  border-top: 1rpx solid #F5F5F5;
  margin-top: 8rpx;
}

.share-cancel:active {
  background: #F8F8F8;
}

/* 更多按钮 */
.more-btn {
  padding: 10rpx 20rpx;
  margin-left: 16rpx;
}

.more-icon {
  font-size: 32rpx;
  color: #999;
  letter-spacing: 4rpx;
}

/* 操作弹窗遮罩 */
.action-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
}

/* 操作弹窗 */
.action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #F7F7F7;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1000;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-sheet.show {
  transform: translateY(0);
}

.action-sheet-content {
  background: #FFFFFF;
  margin: 16rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.action-sheet-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.action-sheet-item:last-child {
  border-bottom: none;
}

.action-sheet-item:active {
  background: #F8F8F8;
}

.action-sheet-item.danger .action-sheet-text {
  color: #FF6B6B;
}

.action-sheet-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.action-sheet-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.action-sheet-tag {
  font-size: 24rpx;
  color: #999;
  padding: 6rpx 16rpx;
  background: #F5F5F5;
  border-radius: 20rpx;
}

.action-sheet-cancel {
  background: #FFFFFF;
  margin: 0 16rpx 16rpx;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 30rpx;
  color: #666;
}

.action-sheet-cancel:active {
  background: #F8F8F8;
}
