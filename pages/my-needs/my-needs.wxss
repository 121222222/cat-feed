/* 我的互助页样式 */
.page-container {
  min-height: 100vh;
  background: #F8F8F8;
  padding-bottom: 140rpx;
}

.filter-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 16rpx 20rpx;
  gap: 12rpx;
  overflow-x: auto;
  white-space: nowrap;
  border-bottom: 1rpx solid #F5EDE5;
}

.filter-tab {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  color: #999;
  background: #F5F5F5;
  flex-shrink: 0;
}

.filter-tab.active {
  background: #FFEFE9;
  color: #FFBAA3;
  font-weight: 600;
}

.list-container {
  padding: 20rpx 30rpx;
}

/* 互助卡片样式 */
.help-card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 186, 163, 0.08);
}

.help-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.type-tag {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.need-tag {
  background: #FFEFE9;
  color: #FF6B6B;
}

.offer-tag {
  background: #E8F8E8;
  color: #52C41A;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-open { background: #E6F7FF; color: #1890FF; }
.status-closed { background: #F5F5F5; color: #999; }

.help-body {
  padding-bottom: 16rpx;
}

.help-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.help-desc {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.help-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.help-location, .help-time {
  font-size: 24rpx;
  color: #999;
}

.help-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F5EDE5;
}

.action-btn {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.close-btn {
  background: #FFF7F4;
  color: #FFBAA3;
}

.delete-btn {
  background: #FFF2F0;
  color: #FF4D4F;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #FFBAA3, #E8A48D);
  color: #FFF;
  border-radius: 40rpx;
  font-size: 28rpx;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 120rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFBAA3, #E8A48D);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 186, 163, 0.4);
  z-index: 100;
  color: #FFF;
  font-size: 48rpx;
}
