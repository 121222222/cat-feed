<view class="login-page">
  <!-- 背景图片 -->
  <image class="bg-img" src="/assets/images/login-bg(1).png" mode="aspectFill"></image>
  
  <!-- 顶部Logo -->
  <view class="top-logo">
    <text class="logo-text">喵邻帮</text>
  </view>
  
  <!-- 问候语 -->
  <view class="greeting">
    <text class="greeting-title">你好！</text>
    <text class="greeting-subtitle">欢迎来到喵邻帮</text>
  </view>
  
  <!-- 底部按钮区域 -->
  <view class="bottom-area">
    <!-- 微信登录按钮 -->
    <button class="btn login-btn" bindtap="onLogin">
      <image class="wechat-icon" src="/assets/icons/wechat.svg" mode="aspectFit"></image>
      <text>微信登录</text>
    </button>
    
    <!-- 手机号登录按钮 -->
    <button class="btn phone-btn" bindtap="showPhoneLoginPopup">
      <text>手机号登录</text>
    </button>
    
    <!-- 协议勾选 -->
    <view class="agreement">
      <view class="checkbox-wrap" bindtap="toggleAgreement">
        <view class="checkbox {{agreed ? 'checked' : ''}}">
          <text wx:if="{{agreed}}">✓</text>
        </view>
      </view>
      <text class="agreement-text">登录即代表同意<text class="link" bindtap="showUserAgreement">《用户协议》</text>和<text class="link" bindtap="showPrivacy">《隐私政策》</text></text>
    </view>
    
    <!-- 管理员入口 -->
    <view class="admin-entry" bindtap="goAdminLogin">
      <text class="admin-text">管理员入口</text>
    </view>
  </view>

  <!-- 手机号登录弹窗 - 使用 wx:if 彻底控制渲染 -->
  <block wx:if="{{showPhoneLogin}}">
    <view class="verify-mask" bindtap="hidePhoneLogin"></view>
    <view class="verify-popup show">
      <view class="verify-header">
        <text class="verify-title">手机号登录</text>
        <text class="verify-close" bindtap="hidePhoneLogin">×</text>
      </view>
      <view class="verify-content">
        <view class="input-group">
          <text class="input-label">手机号</text>
          <input class="input-field" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
        </view>
        <view class="input-group">
          <text class="input-label">验证码</text>
          <view class="code-row">
            <input class="input-field code-input" type="number" maxlength="6" placeholder="请输入验证码" value="{{verifyCode}}" bindinput="onCodeInput" />
            <view class="send-code-btn {{countdown > 0 ? 'disabled' : ''}}" bindtap="sendVerifyCode">
              <text>{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="verify-btn" bindtap="phoneLogin">
        <text>确认登录</text>
      </view>
    </view>
  </block>
</view>
