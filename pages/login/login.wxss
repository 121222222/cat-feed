/* 登录页面样式 */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFBAA3, #E8A48D, #FFD4C4);
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* 背景图片 */
.bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* ========== 顶部Logo ========== */
.top-logo {
  position: relative;
  z-index: 1;
  padding-top: 120rpx;
  text-align: center;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 800;
  color: #FFFFFF;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* ========== 问候语 ========== */
.greeting {
  position: relative;
  z-index: 1;
  padding: 60rpx 60rpx 0;
  display: flex;
  flex-direction: column;
}

.greeting-title {
  font-size: 72rpx;
  font-weight: 800;
  color: #FFFFFF;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.greeting-subtitle {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 10rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* ========== 底部按钮区域 ========== */
.bottom-area {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 10;
  padding: 60rpx 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 按钮通用样式 */
.btn {
  width: 100% !important;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  margin: 0;
  padding: 0;
  transition: all 0.2s ease;
}

.btn::after {
  border: none;
}

.btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

/* 登录按钮 - 实心 */
.login-btn {
  background: linear-gradient(135deg, #FF8A65, #FFAB91);
  color: #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(255, 138, 101, 0.5);
  margin-bottom: 24rpx;
}

/* 注册按钮 - 描边 */
.register-btn {
  background: transparent;
  color: #FFFFFF;
  border: 3rpx solid rgba(255, 255, 255, 0.8) !important;
  box-shadow: none;
}

/* ========== 协议勾选 ========== */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  padding: 0 10rpx;
  width: 100%;
}

.checkbox-wrap {
  flex-shrink: 0;
  margin-right: 10rpx;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #FF8A65;
  background: transparent;
  transition: all 0.2s ease;
}

.checkbox.checked {
  background: #FFFFFF;
  border-color: #FFFFFF;
}

.agreement-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1;
  white-space: nowrap;
  flex-shrink: 0;
}

.link {
  color: #FFFFFF;
  font-weight: 600;
  text-decoration: underline;
}

/* ========== 管理员入口 ========== */
.admin-entry {
  margin-top: 30rpx;
  padding: 16rpx 32rpx;
}

.admin-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  letter-spacing: 2rpx;
  text-decoration: underline;
}
