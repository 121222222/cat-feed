<view class="page-container">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="profile-bg">
      <image class="profile-bg-img" src="/assets/images/mine-header-bg.png" mode="aspectFill"></image>
    </view>
    <view class="profile-info">
      <view class="profile-avatar-wrap" bindtap="onChangeAvatar">
        <view class="avatar avatar-xl">
          <image src="{{userInfo.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="avatar-edit-icon">📷</view>
      </view>
      <view class="profile-detail">
        <view class="profile-name-row">
          <text class="profile-name">{{userInfo.name || '铲屎官'}}</text>
        </view>
        <text class="profile-dorm" wx:if="{{userInfo.dormitory}}">📍 {{userInfo.dormitory}}</text>
        <view class="profile-stats">
          <view class="stat-item" bindtap="goMyPosts">
            <text class="stat-num">{{postCount || 0}}</text>
            <text class="stat-label">动态</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item">
            <text class="stat-num">{{likeCount || 0}}</text>
            <text class="stat-label">获赞</text>
          </view>
          <view class="stat-divider"></view>
          <view class="stat-item" bindtap="goMyCats">
            <text class="stat-num">{{catCount || 0}}</text>
            <text class="stat-label">猫咪</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 我的猫咪 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">🐱 我的猫咪</text>
      <text class="section-more" bindtap="goMyCats">管理 ›</text>
    </view>
    <scroll-view scroll-x class="cat-scroll">
      <view class="cat-card" wx:for="{{cats}}" wx:key="id">
        <view class="cat-card-avatar">
          <image src="{{item.avatar}}" mode="aspectFill"></image>
          <view class="cat-card-placeholder" wx:if="{{!item.avatar}}">🐱</view>
        </view>
        <text class="cat-card-name">{{item.name}}</text>
        <text class="cat-card-info">{{item.breed || '未设置'}} · {{item.age || '未设置'}}</text>
      </view>
      <view class="cat-card add-cat" bindtap="goAddCat">
        <text class="add-icon">+</text>
        <text class="add-text">添加猫咪</text>
      </view>
    </scroll-view>
  </view>

  <!-- 我的内容 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📝 我的内容</text>
    </view>
    <view class="menu-group">
      <view class="menu-item" bindtap="goMyPosts">
        <view class="menu-icon-wrap" style="background:#FFF2E6;">
          <text class="menu-icon">📷</text>
        </view>
        <text class="menu-text">我的动态</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyDrafts">
        <view class="menu-icon-wrap" style="background:#FFF8E6;">
          <text class="menu-icon">📝</text>
        </view>
        <text class="menu-text">我的草稿</text>
        <view class="draft-badge" wx:if="{{draftCount > 0}}">{{draftCount}}</view>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goMyHelps">
        <view class="menu-icon-wrap" style="background:#E8F8E8;">
          <text class="menu-icon">🤝</text>
        </view>
        <text class="menu-text">我的互助</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 设置 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">⚙️ 设置</text>
    </view>
    <view class="menu-group">
      <view class="menu-item" bindtap="goProfile">
        <view class="menu-icon-wrap" style="background:#FFF2E6;">
          <text class="menu-icon">✏️</text>
        </view>
        <text class="menu-text">编辑资料</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goSettings">
        <view class="menu-icon-wrap" style="background:#E6F7FF;">
          <text class="menu-icon">🔐</text>
        </view>
        <text class="menu-text">账号安全</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goHelp">
        <view class="menu-icon-wrap" style="background:#FFF2F0;">
          <text class="menu-icon">❓</text>
        </view>
        <text class="menu-text">帮助中心</text>
        <text class="menu-arrow">›</text>
      </view>
      <!-- 管理员入口 -->
      <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
        <view class="menu-icon-wrap" style="background:#E8F8E8;">
          <text class="menu-icon">👑</text>
        </view>
        <text class="menu-text">管理员后台</text>
        <view class="admin-tag">管理</view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="section">
    <view class="logout-btn" bindtap="onLogout">退出登录</view>
  </view>

  <view style="height: 140rpx;"></view>
</view>
