/* 发布动态页样式 */
.form-container {
  padding: 20rpx 30rpx 200rpx;
  background: #F8F8F8;
  min-height: 100vh;
}

/* 照片上传区域 */
.photo-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 186, 163, 0.08);
}

.photo-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
}

.photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #FFF;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  border: 2rpx dashed #FFD4C4;
  background: #FFF7F4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-add-icon {
  font-size: 48rpx;
}

.photo-add-text {
  font-size: 24rpx;
  color: #FFBAA3;
}

.photo-count {
  font-size: 20rpx;
  color: #BBB;
}

.photo-tips {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
}

.tip-icon {
  font-size: 24rpx;
}

/* 表单区块 */
.form-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 186, 163, 0.08);
}

/* 标题输入 */
.title-input {
  font-size: 32rpx;
  font-weight: 600;
  color: #2D2D2D;
  width: 100%;
  padding: 10rpx 0;
}

.title-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 8rpx;
}

/* 内容输入 */
.content-textarea {
  width: 100%;
  min-height: 280rpx;
  font-size: 28rpx;
  color: #2D2D2D;
  line-height: 1.7;
  box-sizing: border-box;
}

.content-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #BBB;
  margin-top: 8rpx;
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.section-opt {
  font-size: 24rpx;
  color: #BBB;
}

/* 分类选项 */
.category-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-option {
  padding: 14rpx 28rpx;
  border-radius: 30rpx;
  background: #F5F5F5;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.category-option.active {
  background: #FFEFE9;
  color: #FFBAA3;
  border-color: #FFBAA3;
}

/* 猫咪选项 */
.cat-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-option {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: #F5F5F5;
  font-size: 26rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.cat-option.active {
  background: #FFEFE9;
  color: #FFBAA3;
  border-color: #FFBAA3;
}

.cat-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FFD4C4;
}

.no-cat-tip {
  font-size: 26rpx;
  color: #999;
}

.no-cat-tip .link {
  color: #FFBAA3;
  text-decoration: underline;
}

/* 话题标签 */
.topic-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: #F5F5F5;
  font-size: 24rpx;
  color: #666;
  border: 2rpx solid transparent;
}

.topic-tag.active {
  background: #E8F4FD;
  color: #1890FF;
  border-color: #91D5FF;
}

.topic-tag.topic-add {
  background: #FFF7F4;
  color: #FFBAA3;
  border: 2rpx dashed #FFD4C4;
}

/* 自定义话题输入 */
.custom-topic-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5EDE5;
}

.topic-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F8F8F8;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #333;
}

.topic-confirm-btn {
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 36rpx;
}

/* 提交栏 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 20rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.submit-row {
  display: flex;
  gap: 20rpx;
}

.btn-draft {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  background: #F5F5F5;
  color: #666;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-publish {
  flex: 2;
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #FF8A6B, #FF6B4A);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-publish:active {
  opacity: 0.85;
}

/* 可见范围选择 */
.visibility-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.visibility-option {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #F8F8F8;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.visibility-option.active {
  background: #FFF7F4;
  border-color: #FFBAA3;
}

.visibility-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.visibility-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.visibility-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2D2D2D;
}

.visibility-desc {
  font-size: 22rpx;
  color: #999;
}

.visibility-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFBAA3;
  color: #FFFFFF;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
