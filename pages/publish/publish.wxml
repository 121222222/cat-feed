<view class="page-container">
  <view class="form-container">
    <!-- 媒体类型切换 -->
    <view class="media-type-switch">
      <view class="media-type-item {{mediaType === 'image' ? 'active' : ''}}" bindtap="switchMediaType" data-type="image">
        <text class="media-type-icon">📷</text>
        <text>图片</text>
      </view>
      <view class="media-type-item {{mediaType === 'video' ? 'active' : ''}}" bindtap="switchMediaType" data-type="video">
        <text class="media-type-icon">🎬</text>
        <text>视频</text>
      </view>
    </view>

    <!-- 照片上传区域 -->
    <view class="photo-section" wx:if="{{mediaType === 'image'}}">
      <view class="photo-upload-area">
        <view class="photo-item" wx:for="{{photos}}" wx:key="*this">
          <image src="{{item}}" mode="aspectFill" class="photo-img" bindtap="previewPhoto" data-url="{{item}}"></image>
          <view class="photo-delete" catchtap="deletePhoto" data-index="{{index}}">×</view>
        </view>
        <view class="photo-add" bindtap="choosePhoto" wx:if="{{photos.length < 9}}">
          <text class="photo-add-icon">📷</text>
          <text class="photo-add-text">添加照片</text>
          <text class="photo-count">{{photos.length}}/9</text>
        </view>
      </view>
      <view class="photo-tips">
        <text class="tip-icon">💡</text>
        <text>添加清晰的猫咪照片，让分享更生动~</text>
      </view>
    </view>

    <!-- 实况图上传区域 -->
    <view class="photo-section" wx:if="{{mediaType === 'live'}}">
      <view class="live-photo-header">
        <text class="live-badge">✨ Live Photo</text>
        <text class="live-desc">支持上传 iPhone 实况照片</text>
      </view>
      <view class="photo-upload-area">
        <view class="photo-item live-photo-item" wx:for="{{livePhotos}}" wx:key="index">
          <image src="{{item.image}}" mode="aspectFill" class="photo-img" bindtap="previewLivePhoto" data-index="{{index}}"></image>
          <view class="live-indicator">
            <text>LIVE</text>
          </view>
          <view class="photo-delete" catchtap="deleteLivePhoto" data-index="{{index}}">×</view>
        </view>
        <view class="photo-add live-photo-add" bindtap="chooseLivePhoto" wx:if="{{livePhotos.length < 9}}">
          <text class="photo-add-icon">✨</text>
          <text class="photo-add-text">添加实况照片</text>
          <text class="photo-count">{{livePhotos.length}}/9</text>
        </view>
      </view>
      <view class="photo-tips">
        <text class="tip-icon">💡</text>
        <text>实况照片将在查看时自动播放动态效果~</text>
      </view>
    </view>

    <!-- 视频上传区域 -->
    <view class="video-section" wx:if="{{mediaType === 'video'}}">
      <view class="video-upload-area">
        <!-- 已选择的视频 -->
        <view class="video-preview" wx:if="{{video.tempFilePath}}">
          <video 
            class="video-player" 
            src="{{video.tempFilePath}}" 
            controls 
            object-fit="contain"
            show-center-play-btn="{{true}}"
            enable-progress-gesture="{{false}}"
          ></video>
          <view class="video-delete" catchtap="deleteVideo">×</view>
          <view class="video-duration">{{video.durationText}}</view>
        </view>
        <!-- 添加视频按钮 -->
        <view class="video-add" bindtap="chooseVideo" wx:if="{{!video.tempFilePath}}">
          <text class="video-add-icon">🎬</text>
          <text class="video-add-text">添加视频</text>
          <text class="video-limit">最长60秒</text>
        </view>
      </view>
      <!-- 视频封面设置 -->
      <view class="video-cover-section" wx:if="{{video.tempFilePath}}">
        <view class="section-header">
          <text class="section-icon">🖼️</text>
          <text class="section-title">视频封面</text>
          <text class="section-opt">（首页展示用）</text>
        </view>
        <view class="video-cover-area">
          <view class="video-cover-preview" wx:if="{{video.thumbTempFilePath}}">
            <image class="cover-img" src="{{video.thumbTempFilePath}}" mode="aspectFill"></image>
            <view class="cover-change" bindtap="chooseVideoCover">更换封面</view>
          </view>
          <view class="video-cover-add" wx:else bindtap="chooseVideoCover">
            <text class="cover-add-icon">+</text>
            <text class="cover-add-text">选择封面图</text>
          </view>
        </view>
      </view>
      <view class="photo-tips">
        <text class="tip-icon">💡</text>
        <text>上传有趣的猫咪视频，最长支持60秒~</text>
      </view>
    </view>

    <!-- 标题输入 -->
    <view class="form-section">
      <input class="title-input" placeholder="给分享取个标题吧~" maxlength="30" value="{{form.title}}" bindinput="onInput" data-field="title" />
      <text class="title-count">{{form.title.length || 0}}/30</text>
    </view>

    <!-- 内容输入 -->
    <view class="form-section">
      <textarea class="content-textarea" placeholder="分享你和猫咪的日常故事、养猫心得、趣事萌照..." maxlength="1000" value="{{form.content}}" bindinput="onInput" data-field="content"></textarea>
      <text class="content-count">{{form.content.length || 0}}/1000</text>
    </view>

    <!-- 分类选择 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">🏷️</text>
        <text class="section-title">选择分类</text>
      </view>
      <view class="category-options">
        <view class="category-option {{form.category === 'daily' ? 'active' : ''}}" bindtap="setCategory" data-cat="daily">
          <text>🐾 日常</text>
        </view>
        <view class="category-option {{form.category === 'cute' ? 'active' : ''}}" bindtap="setCategory" data-cat="cute">
          <text>😻 卖萌</text>
        </view>
        <view class="category-option {{form.category === 'food' ? 'active' : ''}}" bindtap="setCategory" data-cat="food">
          <text>🍲 喂食</text>
        </view>
        <view class="category-option {{form.category === 'health' ? 'active' : ''}}" bindtap="setCategory" data-cat="health">
          <text>💊 健康</text>
        </view>
        <view class="category-option {{form.category === 'tips' ? 'active' : ''}}" bindtap="setCategory" data-cat="tips">
          <text>📖 养猫经验</text>
        </view>
      </view>
    </view>

    <!-- 猫咪标签（可选） -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">🐱</text>
        <text class="section-title">关联我的猫咪</text>
        <text class="section-opt">（可选）</text>
      </view>
      <view class="cat-options" wx:if="{{myCats.length > 0}}">
        <view class="cat-option {{form.catId === item.id ? 'active' : ''}}" wx:for="{{myCats}}" wx:key="id" bindtap="selectCat" data-id="{{item.id}}" data-name="{{item.name}}" data-breed="{{item.breed}}">
          <image class="cat-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <text>{{item.name}}</text>
          <text class="cat-breed-tag" wx:if="{{item.breed}}">{{item.breed}}</text>
        </view>
        <view class="cat-option {{!form.catId ? 'active' : ''}}" bindtap="selectCat" data-id="" data-breed="">
          <text>不关联</text>
        </view>
      </view>
      <view class="no-cat-tip" wx:else>
        <text>还没有添加猫咪，</text>
        <text class="link" bindtap="goAddCat">去添加</text>
      </view>
    </view>

    <!-- 话题标签 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">#</text>
        <text class="section-title">添加话题</text>
        <text class="section-opt">（可选）</text>
      </view>
      <view class="topic-options">
        <view class="topic-tag {{item.checked ? 'active' : ''}}" wx:for="{{topicOptions}}" wx:key="name" bindtap="toggleTopic" data-index="{{index}}">
          <text>#{{item.name}}</text>
        </view>
        <!-- 自定义话题入口 -->
        <view class="topic-tag topic-add" bindtap="addCustomTopic">
          <text>+ 自定义</text>
        </view>
      </view>
      <!-- 自定义话题输入框 -->
      <view class="custom-topic-input" wx:if="{{showCustomTopic}}">
        <input class="topic-input" placeholder="输入自定义话题" maxlength="10" value="{{customTopicValue}}" bindinput="onCustomTopicInput" />
        <view class="topic-confirm-btn" bindtap="confirmCustomTopic">添加</view>
      </view>
    </view>

    <!-- 可见范围选择 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">👁️</text>
        <text class="section-title">谁可以看</text>
      </view>
      <view class="visibility-options">
        <view class="visibility-option {{form.visibility === 'public' ? 'active' : ''}}" bindtap="setVisibility" data-visibility="public">
          <text class="visibility-icon">🌍</text>
          <view class="visibility-info">
            <text class="visibility-name">公开</text>
            <text class="visibility-desc">所有人可见</text>
          </view>
          <view class="visibility-check" wx:if="{{form.visibility === 'public'}}">✓</view>
        </view>
        <view class="visibility-option {{form.visibility === 'private' ? 'active' : ''}}" bindtap="setVisibility" data-visibility="private">
          <text class="visibility-icon">🔒</text>
          <view class="visibility-info">
            <text class="visibility-name">仅自己可见</text>
            <text class="visibility-desc">仅自己能看到</text>
          </view>
          <view class="visibility-check" wx:if="{{form.visibility === 'private'}}">✓</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部提交 -->
  <view class="submit-bar safe-bottom">
    <view class="submit-row">
      <view class="btn-draft" bindtap="saveDraft">存草稿</view>
      <view class="btn-primary btn-publish" bindtap="onSubmit">发布动态</view>
    </view>
  </view>
</view>
