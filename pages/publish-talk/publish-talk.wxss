/* 简化发布页面样式 */
.page-container {
  min-height: 100vh;
  background: #F8F8F8;
  padding-bottom: 140rpx;
}

.form-container {
  padding: 30rpx;
}

/* 顶部提示 */
.header-tip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.tip-emoji {
  font-size: 48rpx;
}

.tip-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

/* 表单区块 */
.form-section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.section-opt {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 内容输入 */
.content-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #333;
  box-sizing: border-box;
}

.content-count {
  display: block;
  text-align: right;
  font-size: 24rpx;
  color: #BBB;
  margin-top: 16rpx;
}

/* 照片上传 */
.photo-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  background: #F5F5F5;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #DDD;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #BBB;
  line-height: 1;
}

/* 底部提交 */
.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}

.btn-primary {
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  padding: 24rpx;
  border-radius: 50rpx;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-block {
  display: block;
  width: 100%;
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
