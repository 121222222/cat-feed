<view class="page-container">
  <view class="form-container">
    <!-- 类型选择 - 仅在没有预选类型时显示 -->
    <view class="type-section" wx:if="{{!presetType}}">
      <view class="type-card {{form.type === 'need' ? 'active' : ''}}" bindtap="setType" data-type="need">
        <view class="type-icon need-bg">🙋</view>
        <view class="type-info">
          <text class="type-title">我需要帮助</text>
          <text class="type-desc">出差/假期，求帮忙喂猫</text>
        </view>
        <view class="type-check" wx:if="{{form.type === 'need'}}">✓</view>
      </view>
      <view class="type-card {{form.type === 'offer' ? 'active' : ''}}" bindtap="setType" data-type="offer">
        <view class="type-icon offer-bg">🐾</view>
        <view class="type-info">
          <text class="type-title">我可以帮忙</text>
          <text class="type-desc">有空帮邻居喂猫</text>
        </view>
        <view class="type-check" wx:if="{{form.type === 'offer'}}">✓</view>
      </view>
    </view>

    <!-- 标题 -->
    <view class="form-section">
      <input class="title-input" placeholder="{{form.type === 'offer' ? '简要描述一下（如：3年养猫经验）' : '简要描述一下（如：五一假期求帮喂猫）'}}" maxlength="30" value="{{form.title}}" bindinput="onInput" data-field="title" />
    </view>

    <!-- 详细描述 -->
    <view class="form-section">
      <textarea class="content-textarea" placeholder="{{form.type === 'offer' ? '详细说明您的情况' : '详细说明情况'}}" maxlength="500" value="{{form.description}}" bindinput="onInput" data-field="description"></textarea>
      <text class="char-count">{{form.description.length || 0}}/500</text>
    </view>

    <!-- 日期范围（仅求助类型显示） -->
    <view class="form-section" wx:if="{{form.type === 'need'}}">
      <view class="section-header">
        <text class="section-icon">📅</text>
        <text class="section-title">需要帮忙的时间</text>
      </view>
      <view class="date-row">
        <picker mode="date" value="{{form.startDate}}" bindchange="onDateChange" data-field="startDate">
          <view class="date-picker {{form.startDate ? '' : 'placeholder'}}">
            {{form.startDate || '开始日期'}}
          </view>
        </picker>
        <text class="date-separator">至</text>
        <picker mode="date" value="{{form.endDate}}" bindchange="onDateChange" data-field="endDate">
          <view class="date-picker {{form.endDate ? '' : 'placeholder'}}">
            {{form.endDate || '结束日期'}}
          </view>
        </picker>
      </view>
    </view>

    <!-- 关联猫咪（仅求助类型显示） -->
    <view class="form-section" wx:if="{{form.type === 'need'}}">
      <view class="section-header">
        <text class="section-icon">🐱</text>
        <text class="section-title">需要照顾的猫咪</text>
      </view>
      <view class="cat-options" wx:if="{{myCats.length > 0}}">
        <view class="cat-option {{form.catId === item.id ? 'active' : ''}}" wx:for="{{myCats}}" wx:key="id" bindtap="selectCat" data-id="{{item.id}}" data-name="{{item.name}}" data-avatar="{{item.avatar}}">
          <image class="cat-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
          <text>{{item.name}}</text>
        </view>
      </view>
      <view class="no-cat-tip" wx:else>
        <text>还没有添加猫咪，</text>
        <text class="link" bindtap="goAddCat">去添加</text>
      </view>
    </view>

    <!-- 位置信息 -->
    <view class="form-section">
      <view class="section-header">
        <text class="section-icon">📍</text>
        <text class="section-title">所在位置</text>
        <text class="required">*</text>
      </view>
      <view class="location-row">
        <picker class="building-picker" mode="selector" range="{{dormitoryOptions}}" value="{{dormitoryIndex}}" bindchange="onDormitoryChange">
          <view class="form-picker {{form.building ? '' : 'placeholder'}}">
            {{form.building || '选择楼栋'}}
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
        <input class="room-input" type="text" placeholder="房间号" value="{{form.roomNumber}}" bindinput="onInput" data-field="roomNumber" maxlength="10" />
      </view>
    </view>

  </view>

  <!-- 底部提交 -->
  <view class="submit-bar safe-bottom">
    <view class="btn-primary btn-block" bindtap="onSubmit">发布互助</view>
  </view>
</view>
