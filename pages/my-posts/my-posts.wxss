.page-container {
  padding: 20rpx;
  background: #F8F8F8;
  min-height: 100vh;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.post-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #FFEFE9;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.post-info {
  flex: 1;
  overflow: hidden;
}

.post-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.post-stats {
  display: flex;
  gap: 24rpx;
  font-size: 24rpx;
  color: #999;
}

.post-delete {
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: #FFF2F0;
  font-size: 24rpx;
  color: #FF4D4F;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 50rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}
