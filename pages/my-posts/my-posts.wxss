.page-container {
  padding: 20rpx;
  background: #F8F8F8;
  min-height: 100vh;
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.post-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

.post-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #FFEFE9;
  flex-shrink: 0;
}

.cover-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: #FFEFE9;
}

.cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F5F5F5, #E8E8E8);
}

.placeholder-icon {
  font-size: 48rpx;
}

.video-badge {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 10rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: #FFF;
}

.video-icon {
  font-size: 18rpx;
}

.post-info {
  flex: 1;
  overflow: hidden;
}

.post-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.post-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.stats-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 12rpx;
}

.stats-icon:first-child {
  margin-left: 0;
}

.post-delete {
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  background: #FFF2F0;
  font-size: 24rpx;
  color: #FF4D4F;
  flex-shrink: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.empty-btn {
  padding: 16rpx 50rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
}
