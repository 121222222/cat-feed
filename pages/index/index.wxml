<view class="page-container">
  <!-- 顶部渐变头部 -->
  <view class="header">
    <view class="header-bg">
      <!-- 自定义背景图片 -->
      <image class="header-bg-img" src="/assets/images/index-header-bg.jpg" mode="aspectFill"></image>
      <!-- 猫咪线条装饰 -->
      <view class="cat-line-deco">
        <view class="cl-tail"></view>
        <view class="cl-body"></view>
        <view class="cl-neck"></view>
        <view class="cl-head"></view>
        <view class="cl-ear-l"></view>
        <view class="cl-ear-r"></view>
      </view>
      <view class="header-content">
        <view class="greeting">
          <text class="greeting-emoji">🐱</text>
          <view>
            <text class="greeting-text">Hi，{{userInfo.name || '铲屎官'}}</text>
            <text class="greeting-sub">来看看大家的喵星人吧~</text>
          </view>
        </view>
      </view>
      <!-- 搜索栏 -->
      <view class="search-wrap">
        <view class="search-box">
          <text class="search-icon">🔍</text>
          <input class="search-input" placeholder="搜索猫咪日常、品种..." value="{{searchKeyword}}" bindinput="onSearchInput" bindconfirm="onSearch" confirm-type="search" />
          <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 轮播图 -->
  <view class="banner-section" wx:if="{{banners && banners.length > 0}}">
    <swiper class="banner-swiper" indicator-dots="{{banners.length > 1}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#FF8A6B" autoplay circular interval="4000">
      <swiper-item wx:for="{{banners}}" wx:key="index">
        <image class="banner-image" src="{{item.image}}" mode="aspectFill"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 分类标签 -->
  <view class="category-tabs">
    <scroll-view scroll-x class="tabs-scroll" enable-flex>
      <view class="tab-item {{activeCategory === 'all' ? 'active' : ''}}" bindtap="switchCategory" data-cat="all">
        <text>全部</text>
      </view>
      <view class="tab-item {{activeCategory === 'daily' ? 'active' : ''}}" bindtap="switchCategory" data-cat="daily">
        <text>🐾 日常</text>
      </view>
      <view class="tab-item {{activeCategory === 'cute' ? 'active' : ''}}" bindtap="switchCategory" data-cat="cute">
        <text>😻 卖萌</text>
      </view>
      <view class="tab-item {{activeCategory === 'food' ? 'active' : ''}}" bindtap="switchCategory" data-cat="food">
        <text>🍲 喂食</text>
      </view>
      <view class="tab-item {{activeCategory === 'health' ? 'active' : ''}}" bindtap="switchCategory" data-cat="health">
        <text>💊 健康</text>
      </view>
      <view class="tab-item {{activeCategory === 'tips' ? 'active' : ''}}" bindtap="switchCategory" data-cat="tips">
        <text>📖 养猫经验</text>
      </view>
    </scroll-view>
  </view>

  <!-- 空状态 - 放在分类标签下方 -->
  <view class="empty-state" wx:if="{{leftPosts.length === 0 && rightPosts.length === 0 && !loading}}">
    <text class="empty-icon">🐱</text>
    <text class="empty-text">还没有人分享猫咪日常</text>
    <text class="empty-sub">快来发布第一条动态吧~</text>
    <view class="empty-btn" bindtap="goPublish">发布动态</view>
  </view>

  <!-- 两列瀑布流 - 有内容时显示 -->
  <view class="waterfall-container" wx:if="{{leftPosts.length > 0 || rightPosts.length > 0}}">
    <view class="waterfall-column left-column">
      <view class="post-card" wx:for="{{leftPosts}}" wx:key="id" bindtap="goPostDetail" data-id="{{item.id}}">
        <!-- 视频 -->
        <view class="post-img-wrap" wx:if="{{item.mediaType === 'video'}}" style="padding-bottom: {{item.imgRatio || 100}}%;">
          <image class="post-img" src="{{item.videoCover}}" mode="aspectFill" lazy-load wx:if="{{item.videoCover && item.videoCover.length > 10}}"></image>
          <view class="video-placeholder" wx:else>
            <text class="video-play-icon">▶</text>
          </view>
          <view class="video-badge">
            <text class="video-icon">🎬</text>
            <text wx:if="{{item.videoDurationText}}">{{item.videoDurationText}}</text>
          </view>
        </view>
        <!-- 图片 -->
        <view class="post-img-wrap" wx:else style="padding-bottom: {{item.imgRatio || 100}}%;">
          <image class="post-img" src="{{item.images[0]}}" mode="aspectFill" lazy-load></image>
          <view class="img-count" wx:if="{{item.images.length > 1}}">
            <text>{{item.images.length}}图</text>
          </view>
        </view>
        <!-- 内容 -->
        <view class="post-content">
          <text class="post-title">{{item.title}}</text>
          <view class="post-footer">
            <view class="post-user">
              <image class="user-avatar" src="{{item.userAvatar}}" mode="aspectFill"></image>
              <text class="user-name">{{item.userName}}</text>
            </view>
            <view class="post-like {{item.liked ? 'liked' : ''}}" catchtap="onLike" data-id="{{item.id}}">
              <image class="like-icon-img {{item.liked ? 'liked-icon' : ''}}" src="/assets/icons/like.png" mode="aspectFit"></image>
              <text class="like-count">{{item.likes || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view class="waterfall-column right-column">
      <view class="post-card" wx:for="{{rightPosts}}" wx:key="id" bindtap="goPostDetail" data-id="{{item.id}}">
        <!-- 删除按钮（仅作者可见） -->
        <view class="post-delete-btn" wx:if="{{item.userId === currentUserId}}" catchtap="deletePost" data-id="{{item.id}}">
          <text>×</text>
        </view>
        <!-- 视频 -->
        <view class="post-img-wrap" wx:if="{{item.mediaType === 'video'}}" style="padding-bottom: {{item.imgRatio || 100}}%;">
          <image class="post-img" src="{{item.videoCover}}" mode="aspectFill" lazy-load wx:if="{{item.videoCover && item.videoCover.length > 10}}"></image>
          <view class="video-placeholder" wx:else>
            <text class="video-play-icon">▶</text>
          </view>
          <view class="video-badge">
            <text class="video-icon">🎬</text>
            <text wx:if="{{item.videoDurationText}}">{{item.videoDurationText}}</text>
          </view>
        </view>
        <!-- 图片 -->
        <view class="post-img-wrap" wx:else style="padding-bottom: {{item.imgRatio || 100}}%;">
          <image class="post-img" src="{{item.images[0]}}" mode="aspectFill" lazy-load></image>
          <view class="img-count" wx:if="{{item.images.length > 1}}">
            <text>{{item.images.length}}图</text>
          </view>
        </view>
        <!-- 内容 -->
        <view class="post-content">
          <text class="post-title">{{item.title}}</text>
          <view class="post-footer">
            <view class="post-user">
              <image class="user-avatar" src="{{item.userAvatar || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
              <text class="user-name">{{item.userName}}</text>
            </view>
            <view class="post-like {{item.liked ? 'liked' : ''}}" catchtap="onLike" data-id="{{item.id}}">
              <image class="like-icon-img {{item.liked ? 'liked-icon' : ''}}" src="/assets/icons/like.png" mode="aspectFit"></image>
              <text class="like-count">{{item.likes || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-more" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- 发布按钮 FAB -->
  <view class="fab-publish" bindtap="goPublish">
    <text class="fab-icon">+</text>
  </view>

  <!-- 底部占位 -->
  <view style="height: 140rpx;"></view>
</view>
