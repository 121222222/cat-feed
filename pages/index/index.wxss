/* 首页样式 - 瀑布流布局 */
.page-container {
  overflow-x: hidden;
  width: 100%;
}

.header {
  width: 100%;
}

.header-bg {
  background: linear-gradient(135deg, #FFBAA3, #E8A48D, #FFD4C4);
  padding: 30rpx 30rpx 50rpx;
  border-radius: 0 0 50rpx 50rpx;
  position: relative;
  overflow: hidden;
}

/* 自定义背景图片 */
.header-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 猫咪线条装饰 */
.cat-line-deco {
  position: absolute;
  right: -20rpx;
  bottom: 10rpx;
  width: 360rpx;
  height: 300rpx;
  opacity: 0.18;
  z-index: 0;
  transform: scaleX(-1);
}

.cl-tail {
  position: absolute;
  left: 20rpx;
  top: 0;
  width: 80rpx;
  height: 120rpx;
  border: 5rpx solid #FFFFFF;
  border-right: none;
  border-bottom: none;
  border-radius: 80rpx 0 0 0;
}

.cl-body {
  position: absolute;
  left: 20rpx;
  top: 80rpx;
  width: 180rpx;
  height: 160rpx;
  border: 5rpx solid #FFFFFF;
  border-top: none;
  border-radius: 0 0 50% 40%;
}

.cl-neck {
  position: absolute;
  right: 80rpx;
  top: 100rpx;
  width: 80rpx;
  height: 100rpx;
  border: 5rpx solid #FFFFFF;
  border-left: none;
  border-bottom: none;
  border-radius: 0 60rpx 0 0;
}

.cl-head {
  position: absolute;
  right: 30rpx;
  top: 160rpx;
  width: 90rpx;
  height: 80rpx;
  border: 5rpx solid #FFFFFF;
  border-radius: 50%;
}

.cl-ear-l {
  position: absolute;
  right: 90rpx;
  top: 140rpx;
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #FFFFFF;
  border-right: none;
  border-bottom: none;
  transform: rotate(30deg) skewX(-10deg);
}

.cl-ear-r {
  position: absolute;
  right: 42rpx;
  top: 140rpx;
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #FFFFFF;
  border-left: none;
  border-bottom: none;
  transform: rotate(-30deg) skewX(10deg);
}

.header-content {
  padding-top: 10rpx;
  position: relative;
  z-index: 1;
}

.greeting {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.greeting-emoji {
  font-size: 60rpx;
}

.greeting-text {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.greeting-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}

.search-wrap {
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.95);
  border-radius: 50rpx;
  padding: 18rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  color: #BBBBBB;
  font-size: 26rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #BBB;
  padding: 8rpx;
  margin-left: 10rpx;
}

/* 轮播图 */
.banner-section {
  margin: 20rpx 24rpx;
  margin-top: -10rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.banner-swiper {
  width: 100%;
  height: 300rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 分类标签 */
.category-tabs {
  background: #FFFFFF;
  padding: 20rpx 0;
  margin-top: -30rpx;
  border-radius: 30rpx 30rpx 0 0;
  position: relative;
  z-index: 2;
}

.tabs-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background: #F5F5F5;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-weight: 600;
}

/* 瀑布流容器 */
.waterfall-container {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  background: #F8F8F8;
  min-height: 60vh;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 帖子卡片 */
.post-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.post-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 删除按钮 */
.post-delete-btn {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  z-index: 10;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(0,0,0,0.5);
  color: #FFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.post-delete-btn:active {
  background: rgba(255,77,79,0.9);
}

.post-img-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: linear-gradient(135deg, #FFEFE9, #FFD9CE);
}

.post-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.img-count {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(0,0,0,0.5);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

/* 视频标识 */
.video-badge {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0,0,0,0.6);
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.video-icon {
  font-size: 20rpx;
}

.video-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #333, #555);
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-play-icon {
  font-size: 60rpx;
  color: #FFFFFF;
  opacity: 0.8;
}

.post-content {
  padding: 16rpx 20rpx 20rpx;
}

.post-title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-user {
  display: flex;
  align-items: center;
  gap: 10rpx;
  overflow: hidden;
  flex: 1;
}

.user-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFEFE9;
  flex-shrink: 0;
}

.user-name {
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.post-like {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.post-like:active {
  background: #FFF0ED;
}

.post-like.liked {
  color: #EFAA97;
}

.like-count {
  font-size: 22rpx;
  color: #999;
}

.post-like.liked .like-count {
  color: #EFAA97;
}

.like-icon-img {
  width: 32rpx;
  height: 32rpx;
  transition: filter 0.2s ease;
}

.like-icon-img.liked-icon {
  filter: brightness(0) saturate(100%) invert(76%) sepia(25%) saturate(747%) hue-rotate(334deg) brightness(97%) contrast(92%);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  background: #F8F8F8;
  min-height: 50vh;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  color: #FFFFFF;
  font-size: 28rpx;
  padding: 16rpx 50rpx;
  border-radius: 40rpx;
  font-weight: 600;
}

/* 加载状态 */
.loading-more {
  text-align: center;
  padding: 30rpx;
  color: #999;
  font-size: 24rpx;
  background: #F8F8F8;
}

/* 发布按钮 FAB */
.fab-publish {
  position: fixed;
  right: 30rpx;
  bottom: 180rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFBAA3, #E8A48D);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 186, 163, 0.4);
  z-index: 100;
}

.fab-publish:active {
  transform: scale(0.92);
}

.fab-icon {
  font-size: 60rpx;
  font-weight: 300;
  color: #FFFFFF;
  line-height: 1;
}
