/* 首页样式 */
.header {
  width: 100%;
}

.header-bg {
  background: linear-gradient(135deg, #FFBAA3, #E8A48D, #FFD4C4);
  padding: 30rpx 30rpx 60rpx;
  border-radius: 0 0 50rpx 50rpx;
  position: relative;
  overflow: hidden;
}

/* 猫咪线条装饰 - 伸懒腰的猫轮廓 */
.cat-line-deco {
  position: absolute;
  right: -20rpx;
  bottom: 10rpx;
  width: 360rpx;
  height: 300rpx;
  opacity: 0.18;
  z-index: 0;
  transform: scaleX(-1);
}

/* 尾巴 - 向上翘起的曲线 */
.cl-tail {
  position: absolute;
  left: 20rpx;
  top: 0;
  width: 80rpx;
  height: 120rpx;
  border: 5rpx solid #FFFFFF;
  border-right: none;
  border-bottom: none;
  border-radius: 80rpx 0 0 0;
}

/* 身体 - 拱起的弧形 */
.cl-body {
  position: absolute;
  left: 20rpx;
  top: 80rpx;
  width: 180rpx;
  height: 160rpx;
  border: 5rpx solid #FFFFFF;
  border-top: none;
  border-radius: 0 0 50% 40%;
}

/* 脖子 - 连接头和身体的曲线 */
.cl-neck {
  position: absolute;
  right: 80rpx;
  top: 100rpx;
  width: 80rpx;
  height: 100rpx;
  border: 5rpx solid #FFFFFF;
  border-left: none;
  border-bottom: none;
  border-radius: 0 60rpx 0 0;
}

/* 头 - 圆形猫头 */
.cl-head {
  position: absolute;
  right: 30rpx;
  top: 160rpx;
  width: 90rpx;
  height: 80rpx;
  border: 5rpx solid #FFFFFF;
  border-radius: 50%;
}

/* 左耳 */
.cl-ear-l {
  position: absolute;
  right: 90rpx;
  top: 140rpx;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 30rpx solid transparent;
  border-bottom-color: transparent;
  /* 用outline模拟 */
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #FFFFFF;
  border-right: none;
  border-bottom: none;
  transform: rotate(30deg) skewX(-10deg);
}

/* 右耳 */
.cl-ear-r {
  position: absolute;
  right: 42rpx;
  top: 140rpx;
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #FFFFFF;
  border-left: none;
  border-bottom: none;
  transform: rotate(-30deg) skewX(10deg);
}

.header-content {
  padding-top: 10rpx;
  position: relative;
  z-index: 1;
}

.greeting {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 30rpx;
}

.greeting-emoji {
  font-size: 60rpx;
}

.greeting-text {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.greeting-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 4rpx;
}

.search-wrap {
  margin-top: 10rpx;
  position: relative;
  z-index: 1;
}

.search-box {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.95);
  border-radius: 50rpx;
  padding: 18rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  color: #BBBBBB;
  font-size: 26rpx;
}

/* 快捷入口 - 大面积醒目设计 */
.quick-entry {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-top: -40rpx;
}

.entry-card {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 186, 163, 0.18);
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
}

.entry-card:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 16rpx rgba(255, 186, 163, 0.12);
}

.entry-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.entry-icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  flex-shrink: 0;
}

.need-circle {
  background: linear-gradient(135deg, #FFEFE9, #FFE0D6);
}

.feed-circle {
  background: linear-gradient(135deg, #FFF3EF, #FFE3DA);
}

.entry-need {
  border-left: 8rpx solid #FFBAA3;
}

.entry-feed {
  border-left: 8rpx solid #FFD4C4;
}

.entry-info {
  flex: 1;
}

.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #2D2D2D;
  margin-bottom: 6rpx;
}

.entry-desc {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.entry-arrow-circle {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FFEFE9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-arrow {
  font-size: 32rpx;
  color: #FFBAA3;
  font-weight: 700;
}

/* 公告栏 */
.notice-bar {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #FFF7F4, #FFEFE9);
  margin: 24rpx 30rpx 0;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #FFE0D6;
}

.notice-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.notice-swiper {
  flex: 1;
  height: 40rpx;
}

.notice-text {
  font-size: 24rpx;
  color: #666;
  line-height: 40rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.notice-more {
  font-size: 22rpx;
  color: #FFBAA3;
  margin-left: 12rpx;
}

/* 区块 */
.section {
  margin-top: 30rpx;
  padding: 0 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.section-icon {
  font-size: 28rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D2D2D;
}

.section-more {
  font-size: 24rpx;
  color: #FFBAA3;
}

/* 双列需求卡片网格 */
.need-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.need-grid-card {
  width: 48.5%;
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(255, 186, 163, 0.12);
  position: relative;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.need-grid-card:active {
  opacity: 0.85;
}

/* 装饰圆点 */
.card-dot {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFBAA3;
  opacity: 0.35;
  z-index: 1;
}

.dot-tl { top: 16rpx; left: 16rpx; }
.dot-tr { top: 16rpx; right: 16rpx; }
.dot-bl { bottom: 16rpx; left: 16rpx; width: 8rpx; height: 8rpx; }
.dot-br { bottom: 16rpx; right: 16rpx; width: 8rpx; height: 8rpx; }

/* 猫咪图片区域 */
.card-img-wrap {
  width: 100%;
  height: 0;
  padding-bottom: 100%;
  position: relative;
  background: linear-gradient(135deg, #FFEFE9, #FFD9CE);
  overflow: hidden;
}

.card-cat-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.card-img-placeholder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  z-index: 0;
}

.card-status-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 500;
  z-index: 2;
}

.badge-pending {
  background: rgba(255, 186, 163, 0.9);
  color: #FFFFFF;
}

.badge-accepted {
  background: rgba(82, 196, 26, 0.85);
  color: #FFFFFF;
}

/* 卡片信息区域 */
.card-info {
  padding: 16rpx 20rpx 20rpx;
}

.card-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.card-cat-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #2D2D2D;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 60%;
}

.card-reward {
  font-size: 22rpx;
  font-weight: 600;
  color: #FFBAA3;
}

.card-desc {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.card-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-user-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  overflow: hidden;
}

.card-user-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #FFEFE9;
}

.card-user-name {
  font-size: 20rpx;
  color: #999;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.card-paw-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFBAA3, #E8A48D);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 186, 163, 0.3);
}

/* 喂养人横向滚动 */
.feeder-scroll {
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.feeder-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 30rpx 24rpx;
  margin-right: 20rpx;
  width: 220rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 186, 163, 0.08);
}

.feeder-avatar-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

.certified-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #52C41A;
  color: #FFF;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFF;
}

.feeder-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #2D2D2D;
  margin-bottom: 6rpx;
}

.feeder-rating {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.rating-num {
  font-size: 22rpx;
  color: #FFBAA3;
  font-weight: 600;
}

.feeder-count {
  font-size: 20rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.feeder-dorm {
  font-size: 20rpx;
  color: #BBB;
}
