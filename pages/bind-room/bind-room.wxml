<view class="bind-page">
  <!-- 顶部说明 -->
  <view class="header">
    <view class="icon-wrap">
      <text class="icon">🏠</text>
    </view>
    <text class="title">绑定公寓房间号</text>
    <text class="subtitle">为确保社区安全，请绑定您的公寓信息</text>
  </view>

  <!-- 说明卡片 -->
  <view class="notice-card">
    <view class="notice-title">
      <text class="notice-icon">ℹ️</text>
      <text>绑定说明</text>
    </view>
    <view class="notice-content">
      <text>1. 只有公司公寓住户才能使用本小程序的完整功能</text>
      <text>2. 请填写您真实入住的楼栋和房间号</text>
      <text>3. 系统将验证房间号是否在公司公寓名单中</text>
      <text>4. 每个房间号只能绑定一个账号</text>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <view class="form-item">
      <text class="form-label">楼栋</text>
      <picker class="building-picker" mode="selector" range="{{buildingOptions}}" value="{{buildingIndex}}" bindchange="onBuildingChange">
        <view class="picker-content {{buildingIndex >= 0 ? '' : 'placeholder'}}">
          {{buildingIndex >= 0 ? buildingOptions[buildingIndex] : '请选择楼栋'}}
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-item">
      <text class="form-label">房间号</text>
      <input class="form-input" type="text" placeholder="请输入房间号（如：101、1201）" value="{{roomNumber}}" bindinput="onInputRoom" maxlength="10" />
    </view>
  </view>

  <!-- 按钮区域 -->
  <view class="btn-section">
    <button class="bind-btn" bindtap="onBind">验证并绑定</button>
    <view class="back-link" bindtap="goBack">
      <text>暂不绑定，返回</text>
    </view>
  </view>

  <!-- 底部提示 -->
  <view class="footer-tip">
    <text>如有问题请联系管理员</text>
  </view>
</view>
