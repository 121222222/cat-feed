.bind-page {
  min-height: 100vh;
  background: #FFF7F4;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 顶部区域 */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 60rpx;
}

.icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(255, 186, 163, 0.4);
}

.icon {
  font-size: 56rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
}

/* 说明卡片 */
.notice-card {
  background: #FFF8E1;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 40rpx;
  border-left: 6rpx solid #FFB300;
}

.notice-title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #F57C00;
}

.notice-icon {
  margin-right: 8rpx;
}

.notice-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.notice-content text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

/* 表单区域 */
.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 186, 163, 0.1);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.building-picker {
  width: 100%;
}

.picker-content {
  width: 100%;
  height: 96rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-content.placeholder {
  color: #CCC;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999;
}

.form-input {
  width: 100%;
  height: 96rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #333;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #CCC;
}

/* 按钮区域 */
.btn-section {
  margin-top: 60rpx;
}

.bind-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #FFBAA3, #FFD4C4);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(255, 186, 163, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-btn::after {
  border: none;
}

.bind-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.back-link {
  text-align: center;
  margin-top: 30rpx;
  padding: 16rpx;
}

.back-link text {
  font-size: 26rpx;
  color: #999;
}

/* 底部提示 */
.footer-tip {
  position: fixed;
  bottom: 60rpx;
  left: 0;
  right: 0;
  text-align: center;
}

.footer-tip text {
  font-size: 24rpx;
  color: #CCC;
}
